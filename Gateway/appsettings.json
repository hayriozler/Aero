{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Scanner": {
      "Key": "",
      "Issuer": "scanner-issuer",
      "Audience": "scanner-api"
    },
    "Flight": {
      "Key": "",
      "Issuer": "flight-issuer",
      "Audience": "flight-api"
    },
    "Fids": {
      "Key": "",
      "Issuer": "fids-issuer",
      "Audience": "fids-api"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "scannerRoute": {
        "ClusterId": "scannerCluster",
        "AuthorizationPolicy": "ScannerPolicy",
        "Match": {
          "Path": "/api/scanner/{**catch-all}"
        }
      },
      "baggageMessagesRoute": {
        "ClusterId": "scannerCluster",
        "AuthorizationPolicy": "ScannerPolicy",
        "Match": {
          "Path": "/api/baggagemessages"
        }
      },
      "flightsRoute": {
        "ClusterId": "flightsCluster",
        "AuthorizationPolicy": "SharedPolicy",
        "Match": {
          "Path": "/api/flights/{**catch-all}"
        }
      },
      "fidsRoute": {
        "ClusterId": "fidsCluster",
        "AuthorizationPolicy": "SharedPolicy",
        "Match": {
          "Path": "/api/fids"
        }
      },
      "textMessagesRoute": {
        "ClusterId": "textMessagesCluster",
        "AuthorizationPolicy": "SharedPolicy",
        "Match": {
          "Path": "/api/textmessages"
        }
      }
    },
    "Clusters": {
      "scannerCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7001/"
          }
        }
      },
      "flightsCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7002/"
          }
        }
      },
      "fidsCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7003/"
          }
        }
      },
      "textMessagesCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7004/"
          }
        }
      }
    }
  }
}

@page "/login"
@layout LoginLayout
@implements IDisposable
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Microsoft.AspNetCore.Components.PersistentComponentState ApplicationState
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Sign In — Aero.Fids</PageTitle>

<div class="login-backdrop">
    <MudPaper Class="login-card pa-8" Elevation="2">
        <div class="d-flex align-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.FlightTakeoff" Class="mr-2" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.h5">Aero.Fids</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Flight Information Display admin</MudText>
            </div>
        </div>

        @if (ErrorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled" Dense="true">
                @ErrorMessage
            </MudAlert>
        }

        @* Native POST — cookie sign-in needs a real HTTP request, not the interactive circuit,
           so these are plain inputs rather than MudTextField. The token field is filled manually
           (not <AntiforgeryToken />) — that component re-renders empty once the SignalR circuit
           takes over from prerendering, in this project's legacy hosted Blazor Server model. *@
        <form method="post" action="/login" class="login-form">
            <input type="hidden" name="__RequestVerificationToken" value="@_antiforgeryToken" />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />

            <div class="login-field">
                <label for="login-tenant">Tenant</label>
                <input id="login-tenant" name="TenantId" class="login-input"
                       autocomplete="organization" autofocus required placeholder="Enter your tenant" />
            </div>

            <div class="login-field">
                <label for="login-username">Username</label>
                <input id="login-username" name="Username" class="login-input"
                       autocomplete="username" required placeholder="Enter your username" />
            </div>

            <div class="login-field">
                <label for="login-password">Password</label>
                <input id="login-password" name="Password" type="password" class="login-input"
                       autocomplete="current-password" required placeholder="Enter your password" />
            </div>

            <button type="submit" class="login-submit">Sign In</button>
        </form>
    </MudPaper>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private string? ErrorMessage => Error switch
    {
        "1" => "Invalid tenant, username, or password.",
        _ => null,
    };

    private string? _antiforgeryToken;
    private PersistingComponentStateSubscription _persistSubscription;

    protected override void OnInitialized()
    {
        _persistSubscription = ApplicationState.RegisterOnPersisting(PersistToken);

        if (ApplicationState.TryTakeFromJson<string>(nameof(_antiforgeryToken), out var restored))
        {
            _antiforgeryToken = restored;
            return;
        }

        // Only present during prerendering (a real HTTP request); the later interactive render,
        // over the SignalR circuit, has none — that's exactly when the restored value above is used.
        if (HttpContextAccessor.HttpContext is { } httpContext)
            _antiforgeryToken = Antiforgery.GetAndStoreTokens(httpContext).RequestToken;
    }

    private Task PersistToken()
    {
        ApplicationState.PersistAsJson(nameof(_antiforgeryToken), _antiforgeryToken);
        return Task.CompletedTask;
    }

    public void Dispose() => _persistSubscription.Dispose();
}

@page "/admin/field-mappings"
@attribute [Authorize]
@using Aero.Fids.Infrastructure.Flights
@using Aero.Fids.Web.Services
@inject IFieldMappingService FieldMappingService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Field Mappings — Aero.Fids</PageTitle>

<div class="d-flex justify-space-between align-center mb-3" style="gap:16px; flex-wrap:wrap">
    <div>
        <MudText Typo="Typo.h5">Field Mappings</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Where each dataset's fields come from in the source system's messages.</MudText>
    </div>
    <MudTooltip Text="Refresh">
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" />
    </MudTooltip>
</div>

<MudTabs Elevation="1" Rounded="true" Class="mt-2">
    @foreach (var dataset in _datasets)
    {
        <MudTabPanel Text="@dataset.Name">
            <div class="d-flex justify-end mb-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenCreateAsync(dataset))">
                    New Mapping
                </MudButton>
            </div>
            <MudDataGrid T="FieldMappingResponse" Items="MappingsFor(dataset)" Dense="true" Hover="true" Striped="true" Bordered="false" Elevation="0">
                <Columns>
                    <PropertyColumn Property="x => x.TargetField" Title="Target Field" />
                    <TemplateColumn Title="Flight Type" Sortable="false">
                        <CellTemplate>@(context.Item.FlightType ?? "Both")</CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.SourcePath" Title="Source Path" />
                    <TemplateColumn Title="Rule" Sortable="false">
                        <CellTemplate>
                            @if (_ruleableFields.Contains(context.Item.TargetField))
                            {
                                <MudChip T="string" Size="Size.Small" Color="@(context.Item.RuleOperator is null ? Color.Default : Color.Info)" OnClick="@(() => OpenRuleAsync(context.Item))">
                                    @RuleLabel(context.Item)
                                </MudChip>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="" Sortable="false" CellStyle="text-align:right; white-space:nowrap">
                        <CellTemplate>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEditAsync(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context.Item))" />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <NoRecordsContent>
                    <MudText Class="pa-4">No mappings set for this dataset yet.</MudText>
                </NoRecordsContent>
            </MudDataGrid>
        </MudTabPanel>
    }
</MudTabs>

@code {
    private sealed record Dataset(string Name, IReadOnlyList<string> Fields);

    private static readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    private readonly Dataset[] _datasets =
    [
        new("Flight", [
            FidsFlightFields.FlightId, FidsFlightFields.FlightType, FidsFlightFields.DesignatorAirlineCodes, FidsFlightFields.DesignatorFlightNumbers,
            FidsFlightFields.FlightDate, FidsFlightFields.Status, FidsFlightFields.ScheduledTime, FidsFlightFields.EstimatedTime,
            FidsFlightFields.TerminalCode, FidsFlightFields.RouteAirportCode, FidsFlightFields.TenantTimeZone,
        ]),
        new("Gate dataset", [FidsFlightFields.Gates, FidsFlightFields.GateStatuses]),
        new("Belt dataset", [FidsFlightFields.Belts, FidsFlightFields.BeltStatuses]),
        new("Counter dataset", [FidsFlightFields.Counters, FidsFlightFields.CounterStatuses, FidsFlightFields.CounterDisplayCodes]),
        new("Spot dataset", [FidsFlightFields.Spots, FidsFlightFields.SpotStatuses]),
    ];

    private static readonly string[] _ruleableFields =
    [
        FidsFlightFields.GateStatuses, FidsFlightFields.BeltStatuses, FidsFlightFields.CounterStatuses, FidsFlightFields.SpotStatuses,
    ];

    private List<FieldMappingResponse> _mappings = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _mappings = (await FieldMappingService.ListAsync(CancellationToken.None)).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load field mappings: {ex.Message}", Severity.Error);
            _mappings = [];
        }
    }

    private List<FieldMappingResponse> MappingsFor(Dataset dataset) =>
        _mappings.Where(m => dataset.Fields.Contains(m.TargetField)).ToList();

    private async Task OpenCreateAsync(Dataset dataset)
    {
        var parameters = new DialogParameters<FieldMappingDialog> { { x => x.FieldsForDataset, dataset.Fields } };
        var dialog = await DialogService.ShowAsync<FieldMappingDialog>("New Field Mapping", parameters, _dialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadAsync();
    }

    private async Task OpenEditAsync(FieldMappingResponse existing)
    {
        var parameters = new DialogParameters<FieldMappingDialog> { { x => x.Existing, existing } };
        var dialog = await DialogService.ShowAsync<FieldMappingDialog>($"Edit {existing.TargetField}", parameters, _dialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadAsync();
    }

    private static string RuleLabel(FieldMappingResponse m) => m.RuleOperator switch
    {
        null => "Always show",
        FieldMappingRuleOperators.Eq => $"= {m.RuleValue}",
        FieldMappingRuleOperators.StartsWith => $"starts {m.RuleValue}",
        FieldMappingRuleOperators.In => $"in [{m.RuleValue}]",
        _ => m.RuleOperator,
    };

    private async Task OpenRuleAsync(FieldMappingResponse existing)
    {
        var parameters = new DialogParameters<FieldMappingRuleDialog> { { x => x.Existing, existing } };
        var dialog = await DialogService.ShowAsync<FieldMappingRuleDialog>($"Rule for {existing.TargetField}", parameters, _dialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadAsync();
    }

    private async Task DeleteAsync(FieldMappingResponse mapping)
    {
        var label = mapping.FlightType is null ? mapping.TargetField : $"{mapping.TargetField} ({mapping.FlightType})";
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete Field Mapping", $"Remove the mapping for '{label}'?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
            return;

        try
        {
            await FieldMappingService.DeleteAsync(mapping.TargetField, mapping.FlightType, CancellationToken.None);
            Snackbar.Add($"Mapping for '{label}' deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to delete '{label}': {ex.Message}", Severity.Error);
        }
    }
}

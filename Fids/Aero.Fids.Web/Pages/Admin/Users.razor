@page "/admin/users"
@attribute [Authorize]
@using Aero.Fids.Web.Services
@inject IFidsUserService UserService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthState

<PageTitle>Users — Aero.Fids</PageTitle>

<div class="d-flex justify-space-between align-center mb-3" style="gap:16px; flex-wrap:wrap">
    <div>
        <MudText Typo="Typo.h5">Users</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Who can sign in to this Aero.Fids admin.</MudText>
    </div>
    <div class="d-flex align-center" style="gap:8px">
        <MudTooltip Text="Refresh">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" />
        </MudTooltip>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAsync">
            New User
        </MudButton>
    </div>
</div>

<MudDataGrid T="FidsUserResponse" Items="_users" Loading="_loading" SortMode="SortMode.Multiple" Filterable="false"
             Dense="true" Hover="true" Striped="true" Bordered="false" Elevation="1">
    <Columns>
        <PropertyColumn Property="x => x.Username" Title="Username" />
        <PropertyColumn Property="x => x.Role" Title="Role" />
        <TemplateColumn Title="Status" Sortable="false">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@(context.Item.IsActive ? Color.Success : Color.Default)">
                    @(context.Item.IsActive ? "Active" : "Inactive")
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="" Sortable="false" CellStyle="text-align:right; white-space:nowrap">
            <CellTemplate>
                @if (string.Equals(context.Item.Username, _currentUsername, StringComparison.OrdinalIgnoreCase))
                {
                    <MudTooltip Text="You can't delete your own account">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Default" />
                    </MudTooltip>
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context.Item))" />
                }
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEditAsync(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText Class="pa-4">No users found.</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudDataGridPager T="FidsUserResponse" PageSizeOptions="new[] { 10, 25, 50, 100 }" />
    </PagerContent>
</MudDataGrid>

@code {
    private static readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    private List<FidsUserResponse> _users = [];
    private bool _loading;
    private string? _currentUsername;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _currentUsername = state.User.Identity?.Name;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _users = (await UserService.ListAsync(CancellationToken.None)).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load users: {ex.Message}", Severity.Error);
            _users = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateAsync()
    {
        var dialog = await DialogService.ShowAsync<CreateFidsUserDialog>("New User", _dialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadAsync();
    }

    private async Task OpenEditAsync(FidsUserResponse existing)
    {
        var parameters = new DialogParameters<EditFidsUserDialog> { { x => x.Existing, existing } };
        var dialog = await DialogService.ShowAsync<EditFidsUserDialog>($"Edit {existing.Username}", parameters, _dialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadAsync();
    }

    private async Task DeleteAsync(FidsUserResponse user)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete User", $"Remove '{user.Username}'? This cannot be undone.", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
            return;

        try
        {
            await UserService.DeleteAsync(user.Id, CancellationToken.None);
            Snackbar.Add($"'{user.Username}' deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to delete '{user.Username}': {ex.Message}", Severity.Error);
        }
    }
}

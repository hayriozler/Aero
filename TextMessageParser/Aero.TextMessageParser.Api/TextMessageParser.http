Content-Type: application/json

{"message":"BSM\nCHG\n.V/1LZRH\n.F/LH400/12NOV/JFK/Y\n.N/0220123456001\n.S/Y/12A/B/001/123/Y/N/A\n.P/DOE/JOHN\nENDBSM"}


@page "/admin/users"
@attribute [Authorize]
@using Aero.Flights.Web.Services.Identity
@inject IApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Users — AeroFlight</PageTitle>

<div class="d-flex justify-space-between align-center mb-3" style="gap:16px; flex-wrap:wrap">
    <div>
        <MudText Typo="Typo.h5">Users</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Manage users and assign roles.</MudText>
    </div>
    <div class="d-flex align-center" style="gap:8px">
        <MudTooltip Text="Refresh">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadUsersAsync" />
        </MudTooltip>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAsync">
            New User
        </MudButton>
    </div>
</div>

<MudDataGrid T="UserDto" Items="_users" Loading="_loading" SortMode="SortMode.Multiple" Filterable="false"
             Dense="true" Hover="true" Striped="true" Bordered="false" Elevation="1">
    <Columns>
        <PropertyColumn Property="x => x.Username" Title="Username" />
        <PropertyColumn Property="x => x.RealName" Title="Real Name" />
        <TemplateColumn Title="Status" Sortable="false">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@(context.Item.IsActive ? Color.Success : Color.Default)">
                    @(context.Item.IsActive ? "Active" : "Inactive")
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Roles" Sortable="false">
            <CellTemplate>@string.Join(", ", context.Item.Roles)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="" Sortable="false" CellStyle="text-align:right; white-space:nowrap">
            <CellTemplate>
                @if (IsProtected(context.Item))
                {
                    <MudTooltip Text="Admin user is protected and cannot be changed">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Default" />
                    </MudTooltip>
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.History" Size="Size.Small" OnClick="@(() => OpenAuditAsync(context.Item))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEditRolesAsync(context.Item))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context.Item))" />
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText Class="pa-4">No users found.</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudDataGridPager T="UserDto" PageSizeOptions="new[] { 10, 25, 50, 100 }" />
    </PagerContent>
</MudDataGrid>

@code {
    private static readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

    private List<UserDto> _users = [];
    private bool _loading;

    protected override async Task OnInitializedAsync() => await LoadUsersAsync();

    private async Task LoadUsersAsync()
    {
        _loading = true;
        try
        {
            _users = (await Api.GetUsersAsync()).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load users: {ex.Message}", Severity.Error);
            _users = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateAsync()
    {
        var dialog = await DialogService.ShowAsync<CreateUserDialog>("New User", _dialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadUsersAsync();
    }

    private async Task OpenEditRolesAsync(UserDto user)
    {
        var parameters = new DialogParameters<EditUserRolesDialog> { { x => x.User, user } };
        var dialog = await DialogService.ShowAsync<EditUserRolesDialog>($"Roles for {user.Username}", parameters, _dialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadUsersAsync();
    }

    private static bool IsProtected(UserDto user) => string.Equals(user.Username, "admin", StringComparison.OrdinalIgnoreCase);

    private async Task OpenAuditAsync(UserDto user)
    {
        var parameters = new DialogParameters<AuditHistoryDialog>
        {
            { x => x.Loader, () => Api.GetUserAuditAsync(user.Id) },
        };
        await DialogService.ShowAsync<AuditHistoryDialog>($"History — {user.Username}", parameters, _dialogOptions);
    }

    private async Task DeleteAsync(UserDto user)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete User", $"Remove '{user.Username}'? This cannot be undone.", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
            return;

        try
        {
            var deleted = await Api.DeleteUserAsync(user.Id);
            Snackbar.Add(deleted ? $"'{user.Username}' deleted." : "User not found.", deleted ? Severity.Success : Severity.Warning);
            await LoadUsersAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to delete '{user.Username}': {ex.Message}", Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add($"Could not reach the API while deleting '{user.Username}'.", Severity.Error);
        }
    }
}

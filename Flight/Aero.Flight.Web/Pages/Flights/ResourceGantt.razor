@using System.Text.Json
@using Aero.Flights.Web.Services.Flights
@using Aero.Flights.Web.Services.Metadatas
@implements IAsyncDisposable
@inject IFlightsClient Flights
@inject IMetadataClient Metadata
@inject ISnackbar Snackbar
@inject IJSRuntime JsRuntime

<div class="d-flex justify-end mb-3">
    <MudTooltip Text="Refresh">
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="@(() => LoadAsync())" />
    </MudTooltip>
</div>

<div class="d-flex align-center mb-3" style="gap:16px; flex-wrap:wrap">
    <MudSelect T="string" Value="_selectedType" ValueChanged="OnTypeChangedAsync" Label="Resource Type"
               Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:200px">
        @foreach (var option in _resourceTypes)
        {
            <MudSelectItem T="string" Value="@option.ApiType">@option.Label</MudSelectItem>
        }
    </MudSelect>
    <MudDatePicker Date="_date" DateChanged="OnDateChangedAsync" Label="Date" DateFormat="@_dateFormat"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:180px" />
</div>

<BlueprintCard Class="pa-3 mb-3">
    <div class="d-flex align-center mb-1" style="gap:8px">
        <MudIcon Icon="@Icons.Material.Filled.FlightTakeoff" Size="Size.Small" Color="Color.Secondary" />
        <span class="kicker">Unassigned flights</span>
        <MudText Typo="Typo.caption" Color="Color.Secondary">— drag one onto a row below to assign it</MudText>
    </div>

    @if (_poolLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" />
    }

    <div class="gantt-pool" id="gantt-flight-pool">
        @if (!_poolLoading && _pool.Count == 0)
        {
            <div class="gantt-pool-empty">Every flight on this day already has a @CurrentOption.Label.ToLowerInvariant() assigned.</div>
        }
        else
        {
            @foreach (var flight in _pool)
            {
                <div class="gantt-pool-chip gantt-pool-chip--@(flight.Direction.ToLowerInvariant())"
                     draggable="true"
                     data-flight-id="@flight.FlightId"
                     data-direction="@flight.Direction"
                     title="@($"{flight.FlightCode} — {flight.Direction} — {FormatLocal(flight.ScheduledTime)}")">
                    <span class="gantt-pool-chip__code">@flight.FlightCode</span>
                    <span class="gantt-pool-chip__time">@(flight.Direction == "Arrival" ? "ETA/STA" : "ETD/STD") @FormatLocal(flight.ScheduledTime)</span>
                </div>
            }
        }
    </div>
</BlueprintCard>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}

<BlueprintCard Class="pa-2">
<div id="@ContainerId" class="gantt-timeline-container" style="height: 600px"></div>
</BlueprintCard>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private const string ContainerId = "resource-gantt-timeline";

    private static readonly ResourceTypeOption[] _resourceTypes =
    [
        new("Gate", "gates", [MetadataCatalog.RouteOf("gates")], "gate"),
        new("Counter", "counters", [MetadataCatalog.RouteOf("counters")], "counter"),
        new("Park Position", "parkpositions", [MetadataCatalog.RouteOf("parkpositions")], "parkposition"),
        new("Arrival Belt", "arrival-belts", [MetadataCatalog.RouteOf("arrivalbelts")], "arrivalbelt"),
        new("Departure Belt", "departure-belts", [MetadataCatalog.RouteOf("departurebelts")], "departurebelt"),
    ];

    private string _selectedType = _resourceTypes[0].ApiType;
    private DateTime? _date = DateTime.Today;
    private TimeZoneInfo _tenantTimeZone = TimeZoneInfo.Utc;
    private string _dateFormat = TenantDateTimeFormat.DefaultDateFormat;
    private string _timeFormat = TenantDateTimeFormat.DefaultTimeFormat;
    private bool _loading;
    private bool _poolLoading;
    private bool _initialized;
    private int _defaultDurationMinutes = Aero.Flights.Contracts.Flights.ResourceDefaultsConstants.FallbackDurationMinutes;
    private DotNetObjectReference<ResourceGantt>? _dotNetRef;

    private object[] _groups = [];
    private object[] _items = [];
    private List<UnassignedFlightItem> _pool = [];

    private ResourceTypeOption CurrentOption => _resourceTypes.First(o => o.ApiType == _selectedType);

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _tenantTimeZone = TenantTimeZone.Resolve(state.User);
            _dateFormat = TenantDateTimeFormat.ResolveDateFormat(state.User);
            _timeFormat = TenantDateTimeFormat.ResolveTimeFormat(state.User);
        }

        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JsRuntime.InvokeVoidAsync("ganttTimeline.init", ContainerId, _groups, _items, BuildInitialWindowOptions());
            _initialized = true;
        }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException)
        {
            return;
        }

        await TryInvokeAsync("ganttTimeline.enableExternalDrop", ContainerId, _dotNetRef);
        await TryInvokeAsync("ganttTimeline.enablePoolDragSource", "gantt-flight-pool", ContainerId);
        await TryInvokeAsync("ganttTimeline.enableItemMove", ContainerId, _dotNetRef);
        await TryInvokeAsync("ganttTimeline.enableContextMenu", ContainerId, _dotNetRef);
    }

    private async Task TryInvokeAsync(string identifier, params object?[] args)
    {
        try
        {
            await JsRuntime.InvokeVoidAsync(identifier, args);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException ex)
        {
            Snackbar.Add($"Gantt chart feature '{identifier}' failed to load ({ex.Message}). Try a hard refresh (Ctrl+F5).", Severity.Warning);
        }
    }

    private async Task OnTypeChangedAsync(string value)
    {
        _selectedType = value;
        await LoadAsync();
    }

    private async Task OnDateChangedAsync(DateTime? value)
    {
        _date = value;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var option = CurrentOption;
        var day = _date is { } d ? DateOnly.FromDateTime(d) : DateOnly.FromDateTime(DateTime.Today);

        _loading = true;
        _poolLoading = true;
        try
        {
            var codes = new List<string>();
            foreach (var route in option.MetadataRoutes)
            {
                var rows = await Metadata.GetAllAsync(route);
                foreach (var row in rows)
                {
                    if (row.TryGetValue("code", out var codeElement) && codeElement.ValueKind == JsonValueKind.String)
                    {
                        var code = codeElement.GetString();
                        if (!string.IsNullOrWhiteSpace(code))
                            codes.Add(code);
                    }
                }
            }

            _groups = codes
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(c => c, StringComparer.OrdinalIgnoreCase)
                .Select(code => (object)new { id = code, content = code })
                .ToArray();

            var ganttItems = await Flights.GetGanttItemsAsync(option.ApiType, day, day);
            _items = ganttItems
                .Select(item => (object)new
                {
                    id = item.Id,
                    flightId = item.FlightId,
                    itemDirection = item.Direction,
                    group = item.ResourceCode,
                    content = $"{item.FlightDisplay} ({DirectionLetter(item.Direction)}) · {FormatLocal(item.Start)}–{FormatLocal(item.End)}",
                    title = $"{item.FlightDisplay} ({item.Direction})\n{FormatFull(item.Start)} – {FormatFull(item.End)}",
                    start = ToLocalWallClock(item.Start),
                    end = ToLocalWallClock(item.End),
                    className = DirectionClass(item.Direction),
                })
                .ToArray();

            try
            {
                _defaultDurationMinutes = await Flights.GetResourceDefaultDurationMinutesAsync(option.DurationKind);
            }
            catch (Exception)
            {
                _defaultDurationMinutes = Aero.Flights.Contracts.Flights.ResourceDefaultsConstants.FallbackDurationMinutes;
            }

            _pool = (await Flights.GetUnassignedFlightsAsync(option.ApiType, day, day)).ToList();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to load resource timeline: {ex.Message}", Severity.Error);
            _groups = [];
            _items = [];
            _pool = [];
        }
        catch (Exception)
        {
            Snackbar.Add("Could not reach the API while loading the resource timeline.", Severity.Error);
            _groups = [];
            _items = [];
            _pool = [];
        }
        finally
        {
            _loading = false;
            _poolLoading = false;
        }

        if (_initialized)
        {
            await JsRuntime.InvokeVoidAsync("ganttTimeline.updateGroups", ContainerId, _groups);
            await JsRuntime.InvokeVoidAsync("ganttTimeline.updateItems", ContainerId, _items);
        }
    }

    // Invoked from ganttTimeline.js when a pool chip is dropped on a resource row. dropTimeLocal is
    // a naive "wall clock" string (no offset) in the same convention as ToLocalWallClock below.
    [JSInvokable]
    public async Task OnFlightDroppedAsync(long flightId, string direction, string resourceCode, string dropTimeLocal)
    {
        if (!DateTime.TryParse(dropTimeLocal, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var localStart))
        {
            Snackbar.Add($"Could not read the drop time ('{dropTimeLocal}').", Severity.Error);
            return;
        }

        var beginPlan = TenantTimeZone.ToUtcOffset(localStart, _tenantTimeZone);
        var endPlan = beginPlan.AddMinutes(_defaultDurationMinutes);
        var directionSegment = string.Equals(direction, "Arrival", StringComparison.OrdinalIgnoreCase) ? "arrivals" : "departures";
        var option = CurrentOption;

        try
        {
            if (option.ApiType == "parkpositions")
            {
                var route = $"/api/flights/{directionSegment}/{flightId}/parkpositions";
                await Flights.AddParkPositionAsync(route, new Aero.Flights.Contracts.Flights.OpsParkPositionRequest(resourceCode, beginPlan, endPlan));
            }
            else
            {
                var segment = ResolveResourceSegment(option.ApiType);
                if (segment is null)
                {
                    Snackbar.Add($"Unknown resource type '{option.ApiType}'.", Severity.Error);
                    return;
                }

                var route = $"/api/flights/{directionSegment}/{flightId}/{segment}";
                await Flights.AddFlightResourceAsync(route, new FlightResourceRequest(resourceCode, beginPlan, endPlan, null));
            }

            Snackbar.Add($"Assigned {resourceCode} to the flight.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to assign {resourceCode}: {ex.Message}", Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Could not reach the API while assigning the resource.", Severity.Error);
        }
    }

    private static string? ResolveResourceSegment(string apiType) => apiType switch
    {
        "gates" => "gates",
        "counters" => "counters",
        "arrival-belts" => "arrivalbelts",
        "departure-belts" => "departurebelts",
        _ => null,
    };

    // Invoked from ganttTimeline.js when an existing bar is dragged to a different row and/or time.
    // startLocal/endLocal are naive "wall clock" strings, same convention as OnFlightDroppedAsync.
    [JSInvokable]
    public async Task<bool> OnResourceMovedAsync(long resourceId, long flightId, string direction, string newResourceCode, string startLocal, string endLocal)
    {
        if (!DateTime.TryParse(startLocal, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var localStart) ||
            !DateTime.TryParse(endLocal, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var localEnd))
        {
            Snackbar.Add("Could not read the new time.", Severity.Error);
            return false;
        }

        var beginPlan = TenantTimeZone.ToUtcOffset(localStart, _tenantTimeZone);
        var endPlan = TenantTimeZone.ToUtcOffset(localEnd, _tenantTimeZone);
        var directionSegment = string.Equals(direction, "Arrival", StringComparison.OrdinalIgnoreCase) ? "arrivals" : "departures";
        var option = CurrentOption;

        try
        {
            if (option.ApiType == "parkpositions")
            {
                var route = $"/api/flights/{directionSegment}/{flightId}/parkpositions/{resourceId}";
                await Flights.UpdateParkPositionAsync(route, new Aero.Flights.Contracts.Flights.OpsParkPositionRequest(newResourceCode, beginPlan, endPlan));
            }
            else
            {
                var segment = ResolveResourceSegment(option.ApiType);
                if (segment is null)
                {
                    Snackbar.Add($"Unknown resource type '{option.ApiType}'.", Severity.Error);
                    return false;
                }

                var route = $"/api/flights/{directionSegment}/{flightId}/{segment}/{resourceId}";
                await Flights.UpdateFlightResourceAsync(route, new FlightResourceRequest(newResourceCode, beginPlan, endPlan, null));
            }

            Snackbar.Add($"Moved to {newResourceCode}.", Severity.Success);
            await LoadAsync();
            return true;
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to move to {newResourceCode}: {ex.Message}", Severity.Error);
            return false;
        }
        catch (Exception)
        {
            Snackbar.Add("Could not reach the API while moving the resource.", Severity.Error);
            return false;
        }
    }

    // Invoked from ganttTimeline.js's context menu Delete action. Reuses the same Delete endpoint
    // the grid tables (FlightResourceTable/FlightParkPositionTable) already use.
    [JSInvokable]
    public async Task OnDeleteResourceAsync(long resourceId, long flightId, string direction)
    {
        var directionSegment = string.Equals(direction, "Arrival", StringComparison.OrdinalIgnoreCase) ? "arrivals" : "departures";
        var option = CurrentOption;

        try
        {
            if (option.ApiType == "parkpositions")
            {
                await Flights.DeleteParkPositionAsync($"/api/flights/{directionSegment}/{flightId}/parkpositions/{resourceId}");
            }
            else
            {
                var segment = ResolveResourceSegment(option.ApiType);
                if (segment is null)
                {
                    Snackbar.Add($"Unknown resource type '{option.ApiType}'.", Severity.Error);
                    return;
                }

                await Flights.DeleteFlightResourceAsync($"/api/flights/{directionSegment}/{flightId}/{segment}/{resourceId}");
            }

            Snackbar.Add("Resource removed.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to remove resource: {ex.Message}", Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Could not reach the API while removing the resource.", Severity.Error);
        }
    }

    // Invoked from ganttTimeline.js's context menu Paste action — creates a new assignment for the
    // copied flight at the right-clicked row/time, same duration as the copied bar. Same underlying
    // call as OnFlightDroppedAsync (dragging a pool chip in), just with an explicit end time instead
    // of one computed from the tenant's default duration — Paste is a duplicate of a real, already-
    // sized assignment, not a fresh one, so it keeps the copied bar's own length.
    [JSInvokable]
    public async Task OnPasteResourceAsync(long flightId, string direction, string resourceCode, string startLocal, string endLocal)
    {
        if (!DateTime.TryParse(startLocal, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var localStart) ||
            !DateTime.TryParse(endLocal, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var localEnd))
        {
            Snackbar.Add("Could not read the paste time.", Severity.Error);
            return;
        }

        var beginPlan = TenantTimeZone.ToUtcOffset(localStart, _tenantTimeZone);
        var endPlan = TenantTimeZone.ToUtcOffset(localEnd, _tenantTimeZone);
        var directionSegment = string.Equals(direction, "Arrival", StringComparison.OrdinalIgnoreCase) ? "arrivals" : "departures";
        var option = CurrentOption;

        try
        {
            if (option.ApiType == "parkpositions")
            {
                var route = $"/api/flights/{directionSegment}/{flightId}/parkpositions";
                await Flights.AddParkPositionAsync(route, new Aero.Flights.Contracts.Flights.OpsParkPositionRequest(resourceCode, beginPlan, endPlan));
            }
            else
            {
                var segment = ResolveResourceSegment(option.ApiType);
                if (segment is null)
                {
                    Snackbar.Add($"Unknown resource type '{option.ApiType}'.", Severity.Error);
                    return;
                }

                var route = $"/api/flights/{directionSegment}/{flightId}/{segment}";
                await Flights.AddFlightResourceAsync(route, new FlightResourceRequest(resourceCode, beginPlan, endPlan, null));
            }

            Snackbar.Add($"Pasted onto {resourceCode}.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to paste onto {resourceCode}: {ex.Message}", Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Could not reach the API while pasting the resource.", Severity.Error);
        }
    }

    private string ToLocalWallClock(DateTimeOffset value) =>
        TenantTimeZone.ToLocal(value, _tenantTimeZone).ToString("yyyy-MM-ddTHH:mm:ss");

    // vis-timeline's default initial window spans however wide the fed-in items are, which reads as
    // roughly hourly resolution — start on a 2-hour window instead so 5-minute ticks are visible
    // immediately; drag left/right within the chart (vis-timeline's native pan) to see more.
    private object BuildInitialWindowOptions()
    {
        var nowLocal = TenantTimeZone.ToLocal(DateTimeOffset.UtcNow, _tenantTimeZone);
        var selectedDay = _date is { } d ? DateOnly.FromDateTime(d) : DateOnly.FromDateTime(DateTime.Today);
        var start = selectedDay == DateOnly.FromDateTime(nowLocal.Date) ? nowLocal : selectedDay.ToDateTime(TimeOnly.MinValue);

        return new
        {
            start = start.ToString("yyyy-MM-ddTHH:mm:ss"),
            end = start.AddHours(2).ToString("yyyy-MM-ddTHH:mm:ss"),
        };
    }


    private string FormatLocal(DateTimeOffset value) =>
        TenantTimeZone.ToLocal(value, _tenantTimeZone).ToString(_timeFormat);

    private string FormatFull(DateTimeOffset value) =>
        TenantTimeZone.ToLocal(value, _tenantTimeZone).ToString($"{_dateFormat} {_timeFormat}");

    private static string DirectionLetter(string direction) => direction.ToUpperInvariant() switch
    {
        "ARRIVAL" => "A",
        "DEPARTURE" => "D",
        "TURNAROUND" => "T",
        _ => "?",
    };

    private static string DirectionClass(string direction) => direction.ToUpperInvariant() switch
    {
        "ARRIVAL" => "gantt-item-arrival",
        "DEPARTURE" => "gantt-item-departure",
        "TURNAROUND" => "gantt-item-turnaround",
        _ => "",
    };

    public async ValueTask DisposeAsync()
    {
        if (_initialized)
        {
            try
            {
                await JsRuntime.InvokeVoidAsync("ganttTimeline.dispose", ContainerId);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _dotNetRef?.Dispose();
    }

    private sealed record ResourceTypeOption(string Label, string ApiType, string[] MetadataRoutes, string DurationKind);
}

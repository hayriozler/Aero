@using Aero.Flights.Contracts.Flights
@using Aero.Flights.Web.Services
@using Aero.Flights.Web.Services.Metadatas
@inject IMetadataClient Metadata

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string" @bind-Value="_model.ServiceCode" Label="Service Code" Required="true"
                                     RequiredError="Service code is required" SearchFunc="SearchHandlingServicesAsync"
                                     MinCharacters="0" CoerceText="false" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string" @bind-Value="_model.HandlingAgentCode" Label="Handling Agent" Clearable="true"
                                     SearchFunc="SearchHandlingAgentsAsync" MinCharacters="0" CoerceText="false" />
                </MudItem>
                <MudItem xs="12" md="3"><MudDatePicker @bind-Date="_beginActualDate" Label="Actual Begin Date" Clearable="true" DateFormat="@_dateFormat" /></MudItem>
                <MudItem xs="12" md="3"><TimeMaskTextField Time="_beginActualTime" TimeChanged="OnBeginActualTimeChanged" Label="Actual Begin Time" Clearable="true" OnDoubleClick="StampActualBeginNowAndSaveAsync" /></MudItem>
                <MudItem xs="12" md="3"><MudDatePicker @bind-Date="_endActualDate" Label="Actual End Date" Clearable="true" DateFormat="@_dateFormat" /></MudItem>
                <MudItem xs="12" md="3"><TimeMaskTextField Time="_endActualTime" TimeChanged="OnEndActualTimeChanged" Label="Actual End Time" Clearable="true" OnDoubleClick="StampActualEndNowAndSaveAsync" /></MudItem>

                <MudItem xs="12" md="6"><MudNumericField T="decimal?" @bind-Value="_model.AmountActual" Label="Amount (Actual)" Min="0" /></MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Comment" Label="Comment" Lines="2" MaxLength="500" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string" @bind-Value="_model.PayerCompanyCode" Label="Payer" Clearable="true"
                                     SearchFunc="SearchPayerCompaniesAsync" MinCharacters="0" CoerceText="false" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudTooltip Text="Cancel">
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Cancel" />
        </MudTooltip>
        <MudTooltip Text="Save">
            <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary" OnClick="SubmitAsync" />
        </MudTooltip>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    [Parameter]
    public ServiceResponse? Existing { get; set; }

    private MudForm _form = null!;
    private readonly EditModel _model = new();
    private DateTimeOffset? _beginPlan;
    private DateTimeOffset? _endPlan;
    private decimal? _amountPlan;
    private DateTime? _beginActualDate;
    private TimeSpan? _beginActualTime;
    private DateTime? _endActualDate;
    private TimeSpan? _endActualTime;
    private TimeZoneInfo _tenantTimeZone = TimeZoneInfo.Utc;
    private string _dateFormat = TenantDateTimeFormat.DefaultDateFormat;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _tenantTimeZone = TenantTimeZone.Resolve(state.User);
            _dateFormat = TenantDateTimeFormat.ResolveDateFormat(state.User);
        }

        if (Existing is { } e)
        {
            _model.ServiceCode = e.ServiceCode;
            _model.HandlingAgentCode = e.HandlingAgentCode ?? "";
            _model.PayerCompanyCode = e.PayerCompanyCode ?? "";
            _model.AmountActual = e.AmountActual;
            _model.Comment = e.Comment ?? "";

            _beginPlan = e.BeginPlan;
            _endPlan = e.EndPlan;
            _amountPlan = e.AmountPlan;

            if (e.BeginActual is { } ba) (_beginActualDate, _beginActualTime) = ToLocalParts(ba);
            if (e.EndActual is { } ea) (_endActualDate, _endActualTime) = ToLocalParts(ea);
        }
    }

    private (DateTime, TimeSpan) ToLocalParts(DateTimeOffset value)
    {
        var local = TenantTimeZone.ToLocal(value, _tenantTimeZone);
        return (local.Date, local.TimeOfDay);
    }

    private async Task<IEnumerable<string>> SearchHandlingServicesAsync(string search, CancellationToken ct) =>
        await MetadataCodeSearch.SearchAsync(Metadata, MetadataCatalog.RouteOf("handlingservices"), search, ct);

    private async Task<IEnumerable<string>> SearchHandlingAgentsAsync(string search, CancellationToken ct) =>
        await MetadataCodeSearch.SearchAsync(Metadata, MetadataCatalog.RouteOf("companies"), search, ct);

    private async Task<IEnumerable<string>> SearchPayerCompaniesAsync(string search, CancellationToken ct) =>
        await MetadataCodeSearch.SearchAsync(Metadata, MetadataCatalog.RouteOf("companies"), search, ct);

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
            return;

        var request = new ServiceRequest(
            _model.ServiceCode,
            _beginPlan,
            _endPlan,
            _amountPlan,
            Combine(_beginActualDate, _beginActualTime),
            Combine(_endActualDate, _endActualTime),
            _model.AmountActual,
            Blank(_model.HandlingAgentCode),
            Blank(_model.Comment),
            Blank(_model.PayerCompanyCode));

        MudDialog.Close(DialogResult.Ok(request));
    }

    // Entering a time with no date yet is ambiguous, so default it to today's date rather
    // than leaving it blank.
    private void OnBeginActualTimeChanged(TimeSpan? value)
    {
        _beginActualTime = value;
        _beginActualDate ??= DateTime.Today;
    }

    private void OnEndActualTimeChanged(TimeSpan? value)
    {
        _endActualTime = value;
        _endActualDate ??= _beginActualDate ?? DateTime.Today;
    }

    // Double-click on the Actual Begin/End Time field is a shortcut for "this just happened, right
    // now" — stamps today's date/time instead of the operator typing both fields. Services have no
    // status field, so there's nothing to nudge beyond the timestamp itself.
    private void StampActualBeginNow()
    {
        var nowLocal = TenantTimeZone.ToLocal(DateTimeOffset.UtcNow, _tenantTimeZone);
        _beginActualDate = nowLocal.Date;
        _beginActualTime = nowLocal.TimeOfDay;
    }

    private void StampActualEndNow()
    {
        var nowLocal = TenantTimeZone.ToLocal(DateTimeOffset.UtcNow, _tenantTimeZone);
        _endActualDate = nowLocal.Date;
        _endActualTime = nowLocal.TimeOfDay;
    }

    // The double-click gesture itself saves immediately — matching the resource grids' own
    // double-click, which persists the row right away rather than waiting for a separate Save click.
    private async Task StampActualBeginNowAndSaveAsync()
    {
        StampActualBeginNow();
        await SubmitAsync();
    }

    private async Task StampActualEndNowAndSaveAsync()
    {
        StampActualEndNow();
        await SubmitAsync();
    }

    private DateTimeOffset? Combine(DateTime? date, TimeSpan? time) =>
        date is { } d ? TenantTimeZone.ToUtcOffset(d.Date + (time ?? TimeSpan.Zero), _tenantTimeZone) : null;

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    private void Cancel() => MudDialog.Cancel();

    private sealed class EditModel
    {
        public string ServiceCode { get; set; } = "";
        public string HandlingAgentCode { get; set; } = "";
        public string PayerCompanyCode { get; set; } = "";
        public decimal? AmountActual { get; set; }
        public string Comment { get; set; } = "";
    }
}

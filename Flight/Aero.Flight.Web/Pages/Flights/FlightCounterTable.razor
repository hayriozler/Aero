@using System.Text.Json
@using Aero.Flights.Web.Services.Flights
@using Aero.Flights.Web.Services.Metadatas
@inject IFlightsClient Flights
@inject IMetadataClient MetadataData
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<div class="d-flex justify-space-between align-center mb-2">
    <MudText Typo="Typo.subtitle2">Counter allocations</MudText>
    <div class="d-flex align-center" style="gap:4px">
        <MudSelect T="string" @bind-Value="_bulkStatusCode" Label="Bulk status" Clearable="true"
                   Margin="Margin.Dense" Dense="true" Style="min-width:140px">
            @foreach (var status in StatusOptions)
            {
                <MudSelectItem T="string" Value="@status.Code">@status.Label</MudSelectItem>
            }
        </MudSelect>
        <MudTooltip Text="Set status for all Counter allocations">
            <MudIconButton Icon="@Icons.Material.Filled.PlaylistAddCheck" Size="Size.Small" OnClick="BulkUpdateStatusAsync"
                           Disabled="@(ReadOnly || string.IsNullOrWhiteSpace(_bulkStatusCode) || _items.Count == 0)" />
        </MudTooltip>
        <MudTooltip Text="Add Counter">
            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="AddAsync" Disabled="@ReadOnly" />
        </MudTooltip>
    </div>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
}

<MudTable Items="_items" Dense="true" Hover="true" Bordered="false" Elevation="1" Height="100%" FixedHeader="true">
    <HeaderContent>
        <MudTh>Code</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Check-in Class</MudTh>
        <MudTh>Plan Begin</MudTh>
        <MudTh>Actual Begin</MudTh>
        <MudTh>Plan End</MudTh>
        <MudTh>Actual End</MudTh>
        <MudTh>Free</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Code">
            <MudSelect T="string" Value="@(context.Code ?? "")" ValueChanged="@(v => UpdateCodeAsync(context, v))"
                       Clearable="true" Margin="Margin.Dense" Dense="true" Disabled="@ReadOnly" Style="min-width:110px">
                @foreach (var option in CodeOptions)
                {
                    <MudSelectItem T="string" Value="@option.Code">@option.Label</MudSelectItem>
                }
            </MudSelect>
        </MudTd>
        <MudTd DataLabel="Status">
            <MudSelect T="string" Value="@(context.StatusCode ?? "")" ValueChanged="@(v => UpdateStatusAsync(context, v))"
                       Margin="Margin.Dense" Dense="true" Disabled="@ReadOnly" Style="min-width:110px">
                @foreach (var status in StatusOptions)
                {
                    <MudSelectItem T="string" Value="@status.Code">@status.Label</MudSelectItem>
                }
            </MudSelect>
        </MudTd>
        <MudTd DataLabel="Check-in Class">
            <MudSelect T="string" Value="@(context.CheckinClassCode ?? "")" ValueChanged="@(v => UpdateCheckinClassAsync(context, v))"
                       Clearable="true" Margin="Margin.Dense" Dense="true" Disabled="@ReadOnly" Style="min-width:130px">
                @foreach (var option in CheckinClassOptions)
                {
                    <MudSelectItem T="string" Value="@option.Code">@option.Label</MudSelectItem>
                }
            </MudSelect>
        </MudTd>
        <MudTd DataLabel="Plan Begin">
            <div class="d-flex" style="gap:4px">
                <MudDatePicker Date="@ToLocalDate(context.BeginPlan)" DateChanged="@(d => UpdateBeginDateAsync(context, d))"
                               Clearable="true" DateFormat="@_gridDateFormat" AutoClose="true" Margin="Margin.Dense" Disabled="@ReadOnly" Style="min-width:120px" />
                <TimeMaskTextField Time="@ToLocalTime(context.BeginPlan)" TimeChanged="@(t => UpdateBeginTimeAsync(context, t))"
                                   Margin="Margin.Dense" Disabled="@ReadOnly" Style="min-width:80px" />
            </div>
        </MudTd>
        <MudTd DataLabel="Actual Begin">
            <div class="d-flex" style="gap:4px">
                <MudDatePicker Date="@ToLocalDate(context.BeginActual)" DateChanged="@(d => UpdateActualBeginDateAsync(context, d))"
                               Clearable="true" DateFormat="@_gridDateFormat" AutoClose="true" Margin="Margin.Dense" Disabled="@ReadOnly" Style="min-width:120px" />
                <TimeMaskTextField Time="@ToLocalTime(context.BeginActual)" TimeChanged="@(t => UpdateActualBeginTimeAsync(context, t))"
                                   Margin="Margin.Dense" Disabled="@ReadOnly" Style="min-width:80px"
                                   OnDoubleClick="@(() => StampActualBeginNowAsync(context))" />
            </div>
        </MudTd>
        <MudTd DataLabel="Plan End">
            <div class="d-flex" style="gap:4px">
                <MudDatePicker Date="@ToLocalDate(context.EndPlan)" DateChanged="@(d => UpdateEndDateAsync(context, d))"
                               Clearable="true" DateFormat="@_gridDateFormat" AutoClose="true" Margin="Margin.Dense" Disabled="@ReadOnly" Style="min-width:120px" />
                <TimeMaskTextField Time="@ToLocalTime(context.EndPlan)" TimeChanged="@(t => UpdateEndTimeAsync(context, t))"
                                   Margin="Margin.Dense" Disabled="@ReadOnly" Style="min-width:80px" />
            </div>
        </MudTd>
        <MudTd DataLabel="Actual End">
            <div class="d-flex" style="gap:4px">
                <MudDatePicker Date="@ToLocalDate(context.EndActual)" DateChanged="@(d => UpdateActualEndDateAsync(context, d))"
                               Clearable="true" DateFormat="@_gridDateFormat" AutoClose="true" Margin="Margin.Dense" Disabled="@ReadOnly" Style="min-width:120px" />
                <TimeMaskTextField Time="@ToLocalTime(context.EndActual)" TimeChanged="@(t => UpdateActualEndTimeAsync(context, t))"
                                   Margin="Margin.Dense" Disabled="@ReadOnly" Style="min-width:80px"
                                   OnDoubleClick="@(() => StampActualEndNowAsync(context))" />
            </div>
        </MudTd>
        <MudTd DataLabel="Free">
            @if (context.IsComplimentary)
            {
                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" />
            }
            else
            {
                @: —
            }
        </MudTd>
        <MudTd>
            <div class="d-flex justify-end" style="gap:4px">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(context))" Disabled="@ReadOnly" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" Disabled="@ReadOnly" />
            </div>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Color="Color.Secondary">No counter allocations yet.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    [Parameter, EditorRequired]
    public string RouteBase { get; set; } = "";

    [Parameter]
    public bool ReadOnly { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private List<FlightResourceResponse> _items = [];
    private List<FlightResourceCodeOption> _codeOptions = [];
    private List<FlightResourceCodeOption> _statusOptions = [];
    private List<FlightResourceCodeOption> _checkinClassOptions = [];
    private int _defaultDurationMinutes = Aero.Flights.Contracts.Flights.ResourceDefaultsConstants.FallbackDurationMinutes;
    private bool _loading;
    private string? _loadedRoute;
    private string? _bulkStatusCode;
    private TimeZoneInfo _timeZoneManager = TimeZoneInfo.Utc;
    private string _dateFormat = DateTimeFormatter.DefaultDateFormat;
    private string _gridDateFormat = "dd.MM";

    private IReadOnlyList<FlightResourceCodeOption> CodeOptions => _codeOptions;
    private IReadOnlyList<FlightResourceCodeOption> StatusOptions => _statusOptions;
    private IReadOnlyList<FlightResourceCodeOption> CheckinClassOptions => _checkinClassOptions;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _timeZoneManager = TimeZoneManager.Resolve(state.User);
            _dateFormat = DateTimeFormatter.ResolveDateFormat(state.User);
        }

        if (string.IsNullOrWhiteSpace(RouteBase) || RouteBase == _loadedRoute)
            return;

        _loadedRoute = RouteBase;
        _codeOptions = await LoadOptionsAsync(MetadataCatalog.RouteOf("counters"), "Metadata codes");
        _statusOptions = await LoadOptionsAsync(MetadataCatalog.RouteOf("counterstatuses"), "statuses");
        _checkinClassOptions = await LoadOptionsAsync(MetadataCatalog.RouteOf("checkinclasses"), "check-in classes");
        await LoadDefaultDurationAsync();
        await LoadGridDateFormatAsync();
        await LoadAsync();
    }

    private async Task LoadGridDateFormatAsync()
    {
        try
        {
            _gridDateFormat = await Flights.GetResourceGridDateFormatAsync();
        }
        catch (Exception)
        {
            _gridDateFormat = "dd.MM";
        }
    }

    private async Task<List<FlightResourceCodeOption>> LoadOptionsAsync(string route, string what)
    {
        try
        {
            var rows = await MetadataData.GetAllAsync(route);
            var options = new List<FlightResourceCodeOption>();
            foreach (var row in rows)
            {
                if (!row.TryGetValue("code", out var codeElement) || codeElement.ValueKind != JsonValueKind.String)
                    continue;

                var code = codeElement.GetString();
                if (string.IsNullOrWhiteSpace(code))
                    continue;

                var label = code;
                if (row.TryGetValue("description", out var descriptionElement) && descriptionElement.ValueKind == JsonValueKind.String)
                {
                    var description = descriptionElement.GetString();
                    if (!string.IsNullOrWhiteSpace(description))
                        label = $"{code} — {description}";
                }

                var isDefault = row.TryGetValue("isDefault", out var isDefaultElement) && isDefaultElement.ValueKind is JsonValueKind.True or JsonValueKind.False && isDefaultElement.GetBoolean();
                var isOpenValue = row.TryGetValue("isOpenValue", out var isOpenValueElement) && isOpenValueElement.ValueKind is JsonValueKind.True or JsonValueKind.False && isOpenValueElement.GetBoolean();
                var isCloseValue = row.TryGetValue("isCloseValue", out var isCloseValueElement) && isCloseValueElement.ValueKind is JsonValueKind.True or JsonValueKind.False && isCloseValueElement.GetBoolean();

                options.Add(new FlightResourceCodeOption(code, label, isDefault, isOpenValue, isCloseValue));
            }

            return options;
        }
        catch (Exception)
        {
            Snackbar.Add($"Could not load counter {what}.", Severity.Warning);
            return [];
        }
    }

    private async Task LoadDefaultDurationAsync()
    {
        try
        {
            _defaultDurationMinutes = await Flights.GetResourceDefaultDurationMinutesAsync("counter");
        }
        catch (Exception)
        {
            _defaultDurationMinutes = Aero.Flights.Contracts.Flights.ResourceDefaultsConstants.FallbackDurationMinutes;
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = (await Flights.GetCounterResourcesAsync(RouteBase)).ToList();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to load counter allocations: {ex.Message}", Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Could not reach the API while loading counter allocations.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddAsync()
    {
        var parameters = new DialogParameters<FlightCounterEditDialog>
        {
            { x => x.CodeOptions, _codeOptions },
            { x => x.StatusOptions, _statusOptions },
            { x => x.CheckinClassOptions, _checkinClassOptions },
            { x => x.DefaultDurationMinutes, _defaultDurationMinutes },
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<FlightCounterEditDialog>("Add Counter", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not FlightResourceRequest request)
            return;

        try
        {
            await Flights.AddCounterResourceAsync(RouteBase, request);
            Snackbar.Add("Counter added.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to add counter: {ex.Message}", Severity.Error);
        }
    }

    private async Task EditAsync(FlightResourceResponse existing)
    {
        var parameters = new DialogParameters<FlightCounterEditDialog>
        {
            { x => x.Existing, existing },
            { x => x.CodeOptions, _codeOptions },
            { x => x.StatusOptions, _statusOptions },
            { x => x.CheckinClassOptions, _checkinClassOptions },
            { x => x.DefaultDurationMinutes, _defaultDurationMinutes },
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<FlightCounterEditDialog>("Edit Counter", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not FlightResourceRequest request)
            return;

        try
        {
            await Flights.UpdateCounterResourceAsync($"{RouteBase}/{existing.Id}", request);
            Snackbar.Add("Counter updated.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to update counter: {ex.Message}", Severity.Error);
        }
    }

    private async Task BulkUpdateStatusAsync()
    {
        if (string.IsNullOrWhiteSpace(_bulkStatusCode) || _items.Count == 0)
            return;

        var statusLabel = _statusOptions.FirstOrDefault(s => s.Code == _bulkStatusCode)?.Label ?? _bulkStatusCode;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Set status for all?", $"Set all {_items.Count} counter allocations to '{statusLabel}'?", yesText: "Apply", cancelText: "Cancel");
        if (confirmed != true)
            return;

        try
        {
            var result = await Flights.BulkUpdateCounterResourceStatusAsync(RouteBase, _bulkStatusCode);
            _items = result.ToList();
            Snackbar.Add("Counter statuses updated.", Severity.Success);
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to update counter statuses: {ex.Message}", Severity.Error);
        }
    }

    private Task UpdateCodeAsync(FlightResourceResponse item, string? value) =>
        UpdateFieldAsync(item, code: value, statusCode: item.StatusCode, checkinClassCode: item.CheckinClassCode, beginPlan: item.BeginPlan, endPlan: item.EndPlan, beginActual: item.BeginActual, endActual: item.EndActual);

    // Reverse of the double-click gesture: manually picking Occupied/Closed from the inline Status
    // dropdown stamps the matching Actual time to now too, same as the edit dialog's Status select.
    private Task UpdateStatusAsync(FlightResourceResponse item, string? value)
    {
        var beginActual = item.BeginActual;
        var endActual = item.EndActual;
        var selected = _statusOptions.FirstOrDefault(s => string.Equals(s.Code, value, StringComparison.OrdinalIgnoreCase));
        if (selected?.IsOpenValue == true)
            beginActual = NowStamp();
        else if (selected?.IsCloseValue == true)
            endActual = NowStamp();

        return UpdateFieldAsync(item, code: item.Code, statusCode: value, checkinClassCode: item.CheckinClassCode, beginPlan: item.BeginPlan, endPlan: item.EndPlan, beginActual: beginActual, endActual: endActual);
    }

    private Task UpdateCheckinClassAsync(FlightResourceResponse item, string? value) =>
        UpdateFieldAsync(item, code: item.Code, statusCode: item.StatusCode, checkinClassCode: value, beginPlan: item.BeginPlan, endPlan: item.EndPlan, beginActual: item.BeginActual, endActual: item.EndActual);

    private Task UpdateBeginDateAsync(FlightResourceResponse item, DateTime? date) =>
        UpdateFieldAsync(item, code: item.Code, statusCode: item.StatusCode, checkinClassCode: item.CheckinClassCode, beginPlan: CombineDate(item.BeginPlan, date), endPlan: item.EndPlan, beginActual: item.BeginActual, endActual: item.EndActual);

    private Task UpdateBeginTimeAsync(FlightResourceResponse item, TimeSpan? time) =>
        UpdateFieldAsync(item, code: item.Code, statusCode: item.StatusCode, checkinClassCode: item.CheckinClassCode, beginPlan: CombineTime(item.BeginPlan, time), endPlan: item.EndPlan, beginActual: item.BeginActual, endActual: item.EndActual);

    private Task UpdateEndDateAsync(FlightResourceResponse item, DateTime? date) =>
        UpdateFieldAsync(item, code: item.Code, statusCode: item.StatusCode, checkinClassCode: item.CheckinClassCode, beginPlan: item.BeginPlan, endPlan: CombineDate(item.EndPlan, date), beginActual: item.BeginActual, endActual: item.EndActual);

    private Task UpdateEndTimeAsync(FlightResourceResponse item, TimeSpan? time) =>
        UpdateFieldAsync(item, code: item.Code, statusCode: item.StatusCode, checkinClassCode: item.CheckinClassCode, beginPlan: item.BeginPlan, endPlan: CombineTime(item.EndPlan, time), beginActual: item.BeginActual, endActual: item.EndActual);

    private Task UpdateActualBeginDateAsync(FlightResourceResponse item, DateTime? date) =>
        UpdateFieldAsync(item, code: item.Code, statusCode: item.StatusCode, checkinClassCode: item.CheckinClassCode, beginPlan: item.BeginPlan, endPlan: item.EndPlan, beginActual: CombineDate(item.BeginActual, date), endActual: item.EndActual);

    private Task UpdateActualBeginTimeAsync(FlightResourceResponse item, TimeSpan? time) =>
        UpdateFieldAsync(item, code: item.Code, statusCode: item.StatusCode, checkinClassCode: item.CheckinClassCode, beginPlan: item.BeginPlan, endPlan: item.EndPlan, beginActual: CombineTime(item.BeginActual, time), endActual: item.EndActual);

    private Task UpdateActualEndDateAsync(FlightResourceResponse item, DateTime? date) =>
        UpdateFieldAsync(item, code: item.Code, statusCode: item.StatusCode, checkinClassCode: item.CheckinClassCode, beginPlan: item.BeginPlan, endPlan: item.EndPlan, beginActual: item.BeginActual, endActual: CombineDate(item.EndActual, date));

    private Task UpdateActualEndTimeAsync(FlightResourceResponse item, TimeSpan? time) =>
        UpdateFieldAsync(item, code: item.Code, statusCode: item.StatusCode, checkinClassCode: item.CheckinClassCode, beginPlan: item.BeginPlan, endPlan: item.EndPlan, beginActual: item.BeginActual, endActual: CombineTime(item.EndActual, time));

    // Double-click on the Actual Begin/End time cell is a shortcut for "this just happened, right
    // now" — same gesture as the edit dialog, applied directly to the grid row and saved
    // immediately. Nudges status to match CounterStatus's own IsOpenValue/IsCloseValue status.
    private Task StampActualBeginNowAsync(FlightResourceResponse item)
    {
        var statusCode = _statusOptions.FirstOrDefault(s => s.IsOpenValue)?.Code ?? item.StatusCode;
        return UpdateFieldAsync(item, code: item.Code, statusCode: statusCode, checkinClassCode: item.CheckinClassCode, beginPlan: item.BeginPlan, endPlan: item.EndPlan, beginActual: NowStamp(), endActual: item.EndActual);
    }

    private Task StampActualEndNowAsync(FlightResourceResponse item)
    {
        var statusCode = _statusOptions.FirstOrDefault(s => s.IsCloseValue)?.Code ?? item.StatusCode;
        return UpdateFieldAsync(item, code: item.Code, statusCode: statusCode, checkinClassCode: item.CheckinClassCode, beginPlan: item.BeginPlan, endPlan: item.EndPlan, beginActual: item.BeginActual, endActual: NowStamp());
    }

    private DateTimeOffset NowStamp()
    {
        var nowLocal = TimeZoneManager.ToLocal(DateTimeOffset.UtcNow, _timeZoneManager);
        return TimeZoneManager.ToUtcOffset(nowLocal.Date + nowLocal.TimeOfDay, _timeZoneManager);
    }

    // item carries PayerCompanyCode/IsComplimentary through unchanged — none of the per-field
    // callers above touch either, so they're read straight off item rather than threaded through
    // every call site.
    private async Task UpdateFieldAsync(FlightResourceResponse item, string? code, string? statusCode, string? checkinClassCode, DateTimeOffset? beginPlan, DateTimeOffset? endPlan, DateTimeOffset? beginActual, DateTimeOffset? endActual)
    {
        try
        {
            var request = new FlightResourceRequest(Blank(code), beginPlan, endPlan, Blank(statusCode), beginActual, endActual, item.PayerCompanyCode, item.IsComplimentary, Blank(checkinClassCode));
            await Flights.UpdateCounterResourceAsync($"{RouteBase}/{item.Id}", request);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to update counter: {ex.Message}", Severity.Error);
        }
    }

    private DateTimeOffset? CombineDate(DateTimeOffset? existing, DateTime? newDate)
    {
        if (newDate is not { } date)
            return null;

        var time = existing is { } e ? TimeZoneManager.ToLocal(e, _timeZoneManager).TimeOfDay : TimeSpan.Zero;
        return TimeZoneManager.ToUtcOffset(date.Date + time, _timeZoneManager);
    }

    private DateTimeOffset? CombineTime(DateTimeOffset? existing, TimeSpan? newTime)
    {
        if (newTime is not { } time)
            return null;

        var date = existing is { } e ? TimeZoneManager.ToLocal(e, _timeZoneManager).Date : DateTime.Today;
        return TimeZoneManager.ToUtcOffset(date + time, _timeZoneManager);
    }

    private DateTime? ToLocalDate(DateTimeOffset? value) =>
        value is { } v ? TimeZoneManager.ToLocal(v, _timeZoneManager).Date : null;

    private TimeSpan? ToLocalTime(DateTimeOffset? value) =>
        value is { } v ? TimeZoneManager.ToLocal(v, _timeZoneManager).TimeOfDay : null;

    private async Task DeleteAsync(FlightResourceResponse existing)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Counter", $"Remove counter '{existing.Code ?? "(no code)"}'?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
            return;

        try
        {
            await Flights.DeleteCounterResourceAsync($"{RouteBase}/{existing.Id}");
            Snackbar.Add("Counter removed.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to remove counter: {ex.Message}", Severity.Error);
        }
    }

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;
}

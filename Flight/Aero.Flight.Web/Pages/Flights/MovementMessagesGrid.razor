@using Aero.Flights.Contracts.Flights
@using Aero.Flights.Web.Services.Flights
@using Aero.Flights.Web.Services.Metadatas
@inject IFlightsClient Flights
@inject ISnackbar Snackbar

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_items.Count == 0)
{
    <MudText Color="Color.Secondary" Class="pa-4">No movement messages received yet.</MudText>
}
else
{
    <MudDataGrid T="MovementMessageResponse" Items="_items" Dense="true" Hover="true" SortMode="SortMode.Single" Elevation="0" Bordered="false">
        <Columns>
            <PropertyColumn Property="x => x.MessageType" Title="Type" />
            <TemplateColumn Title="Received" SortBy="@(x => x.ReceivedAt)">
                <CellTemplate>@TimeZoneManager.ToLocal(context.Item.ReceivedAt, _timeZoneManager).ToString($"{_dateFormat} {_timeFormat}")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Content" Sortable="false">
                <CellTemplate><pre class="movement-message-content">@context.Item.Content</pre></CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
}

<style>
    .movement-message-content {
        white-space: pre-wrap;
        word-break: break-word;
        font-family: ui-monospace, monospace;
        font-size: 0.8rem;
        margin: 0;
    }
</style>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    [Parameter, EditorRequired]
    public string RouteBase { get; set; } = "";

    private IReadOnlyList<MovementMessageResponse> _items = [];
    private bool _loading = true;
    private string? _loadedRoute;
    private TimeZoneInfo _timeZoneManager = TimeZoneInfo.Utc;
    private string _dateFormat = DateTimeFormatter.DefaultDateFormat;
    private string _timeFormat = DateTimeFormatter.DefaultTimeFormat;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _timeZoneManager = TimeZoneManager.Resolve(state.User);
            _dateFormat = DateTimeFormatter.ResolveDateFormat(state.User);
            _timeFormat = DateTimeFormatter.ResolveTimeFormat(state.User);
        }

        if (string.IsNullOrWhiteSpace(RouteBase) || RouteBase == _loadedRoute)
            return;

        _loadedRoute = RouteBase;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = await Flights.GetMovementMessagesAsync(RouteBase);
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to load movement messages: {ex.Message}", Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Could not reach the API while loading movement messages.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}

@using Aero.Flights.Contracts.Flights
@using Aero.Flights.Web.Services.Flights
@inject IFlightsClient Flights
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<div class="d-flex justify-space-between align-center mb-2">
    <MudText Typo="Typo.subtitle2">Handling Services</MudText>
    <MudTooltip Text="Add Service">
        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="AddAsync" Disabled="@ReadOnly" />
    </MudTooltip>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
}

<MudTable Items="_items" Dense="true" Hover="true" Bordered="false" Elevation="1" Height="100%" FixedHeader="true">
    <HeaderContent>
        <MudTh>Service</MudTh>
        <MudTh>Actual Window</MudTh>
        <MudTh>Amount</MudTh>
        <MudTh>Handling Agent</MudTh>
        <MudTh>Payer</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Service">@context.ServiceCode</MudTd>
        <MudTd DataLabel="Actual Window">@FormatWindow(context.BeginActual, context.EndActual)</MudTd>
        <MudTd DataLabel="Amount">@FormatAmount(context.AmountActual)</MudTd>
        <MudTd DataLabel="Handling Agent">@(context.HandlingAgentCode ?? "—")</MudTd>
        <MudTd DataLabel="Payer">@(context.PayerCompanyCode ?? "—")</MudTd>
        <MudTd>
            <div class="d-flex justify-end" style="gap:4px">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(context))" Disabled="@ReadOnly" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" Disabled="@ReadOnly" />
            </div>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Color="Color.Secondary">No handling services recorded yet.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    [Parameter, EditorRequired]
    public string RouteBase { get; set; } = "";

    [Parameter]
    public bool ReadOnly { get; set; }

    private List<ServiceResponse> _items = [];
    private bool _loading;
    private string? _loadedRoute;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(RouteBase) || RouteBase == _loadedRoute)
            return;

        _loadedRoute = RouteBase;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = (await Flights.GetServicesAsync(RouteBase)).ToList();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to load handling services: {ex.Message}", Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Could not reach the API while loading handling services.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<FlightServiceEditDialog>("Add Handling Service", options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not ServiceRequest request)
            return;

        try
        {
            await Flights.AddServiceAsync(RouteBase, request);
            Snackbar.Add("Handling service added.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to add handling service: {ex.Message}", Severity.Error);
        }
    }

    private async Task EditAsync(ServiceResponse existing)
    {
        var parameters = new DialogParameters<FlightServiceEditDialog>
        {
            { x => x.Existing, existing },
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<FlightServiceEditDialog>("Edit Handling Service", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not ServiceRequest request)
            return;

        try
        {
            await Flights.UpdateServiceAsync($"{RouteBase}/{existing.Id}", request);
            Snackbar.Add("Handling service updated.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to update handling service: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteAsync(ServiceResponse existing)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Handling Service", $"Remove service '{existing.ServiceCode}'?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
            return;

        try
        {
            await Flights.DeleteServiceAsync($"{RouteBase}/{existing.Id}");
            Snackbar.Add("Handling service removed.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to remove handling service: {ex.Message}", Severity.Error);
        }
    }

    private static string FormatWindow(DateTimeOffset? begin, DateTimeOffset? end)
    {
        if (begin is null && end is null) return "—";
        return $"{begin?.ToString("g") ?? "—"} → {end?.ToString("g") ?? "—"}";
    }

    private static string FormatAmount(decimal? actual) =>
        actual?.ToString("0.##") ?? "—";
}

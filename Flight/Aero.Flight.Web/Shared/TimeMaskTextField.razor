@using Aero.Flights.Web.Services

<div @ondblclick="@(() => OnDoubleClick.InvokeAsync())">
    <MudTextField T="string" Value="@_text" ValueChanged="OnTextChangedAsync" Label="@Label" Placeholder="HH:mm"
                  Mask="@TimeInputMask.Mask" Clearable="@Clearable" Disabled="@Disabled" Required="@Required"
                  Immediate="true" Margin="@Margin" Variant="@Variant" Style="@Style" Error="@_hasError" />
</div>

@code {
    // Double-click as a shortcut for "stamp this with the current date/time" — handled by the
    // parent (it owns the paired Date field too, and sometimes a status change), this component
    // just surfaces the gesture.
    [Parameter]
    public EventCallback OnDoubleClick { get; set; }

    [Parameter]
    public TimeSpan? Time { get; set; }

    [Parameter]
    public EventCallback<TimeSpan?> TimeChanged { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public bool Clearable { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public Margin Margin { get; set; } = Margin.None;

    [Parameter]
    public Variant Variant { get; set; } = Variant.Text;

    [Parameter]
    public string? Style { get; set; }

    private string _text = "";
    private bool _hasError;
    private TimeSpan? _lastTime;

    protected override void OnParametersSet()
    {
        if (Time == _lastTime)
            return;

        _lastTime = Time;
        _text = Time is { } t ? $"{(int)t.TotalHours:00}:{t.Minutes:00}" : "";
        _hasError = false;
    }

    private async Task OnTextChangedAsync(string value)
    {
        _text = value;

        if (string.IsNullOrWhiteSpace(value))
        {
            _hasError = false;
            _lastTime = null;
            await TimeChanged.InvokeAsync(null);
            return;
        }

        if (TryParse(value, out var time))
        {
            _hasError = false;
            _lastTime = time;
            await TimeChanged.InvokeAsync(time);
            return;
        }

        // Partial input (still typing, e.g. "19:3") — don't propagate or flag as an error yet.
        _hasError = value.Replace(":", "").Length >= 4;
    }

    private static bool TryParse(string? value, out TimeSpan time)
    {
        time = default;
        var digits = value?.Replace(":", "") ?? "";
        if (digits.Length != 4 || !int.TryParse(digits[..2], out var h) || !int.TryParse(digits[2..], out var m))
            return false;
        if (h > 23 || m > 59)
            return false;

        time = new TimeSpan(h, m, 0);
        return true;
    }
}

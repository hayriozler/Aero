@using AeroFlight.Contracts.SeasonalFlightSchedules
@using AeroFlight.Web.Services.Metadatas
@inject IMetadataClient MetadataData

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudGrid Spacing="3">
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="_model.Direction" Label="Direction" Required="true" Disabled="@(!_directionEditable)">
                        <MudSelectItem T="string" Value="@SeasonalFlightScheduleFlightsPage.DirectionArrival">Arrival</MudSelectItem>
                        <MudSelectItem T="string" Value="@SeasonalFlightScheduleFlightsPage.DirectionDeparture">Departure</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="_model.ScheduleSeasonCode" Label="Season" Required="true" ToStringFunc="@(code => code)">
                        @foreach (var season in Seasons)
                        {
                            <MudSelectItem T="string" Value="@season.Code">@SeasonLabel(season)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <TimeMaskTextField @bind-Time="_model.Time" Label="@(IsArrival ? "STA (Time)" : "STD (Time)")" Required="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_model.AirlineCode" Label="Airline Code" Required="true" MaxLength="3" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_model.FlightNumber" Label="Flight Number" Required="true" MaxLength="10" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudAutocomplete T="string" @bind-Value="_model.AircraftTypeCode" Label="Aircraft Type" Clearable="true"
                                     SearchFunc="SearchAircraftTypesAsync" MinCharacters="0" CoerceText="false"
                                     ToStringFunc="@(code => code)">
                        <ItemTemplate Context="code">@_aircraftTypeLabels.GetValueOrDefault(code, code)</ItemTemplate>
                    </MudAutocomplete>
                </MudItem>

                @if (IsArrival)
                {
                    <MudItem xs="12" md="6">
                        <MudAutocomplete T="string" @bind-Value="_model.OriginAirportCode" Label="Origin Airport" Required="true"
                                         SearchFunc="SearchAirportsAsync" MinCharacters="0" CoerceText="false"
                                         ToStringFunc="@(code => code)">
                            <ItemTemplate Context="code">@_airportLabels.GetValueOrDefault(code, code)</ItemTemplate>
                        </MudAutocomplete>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudAutocomplete T="string" @bind-Value="_model.PreviousAirportCode" Label="Previous Airport" Clearable="true"
                                         SearchFunc="SearchAirportsAsync" MinCharacters="0" CoerceText="false"
                                         ToStringFunc="@(code => code)">
                            <ItemTemplate Context="code">@_airportLabels.GetValueOrDefault(code, code)</ItemTemplate>
                        </MudAutocomplete>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" md="6">
                        <MudAutocomplete T="string" @bind-Value="_model.DestinationAirportCode" Label="Destination Airport" Required="true"
                                         SearchFunc="SearchAirportsAsync" MinCharacters="0" CoerceText="false"
                                         ToStringFunc="@(code => code)">
                            <ItemTemplate Context="code">@_airportLabels.GetValueOrDefault(code, code)</ItemTemplate>
                        </MudAutocomplete>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudAutocomplete T="string" @bind-Value="_model.NextAirportCode" Label="Next Airport" Clearable="true"
                                         SearchFunc="SearchAirportsAsync" MinCharacters="0" CoerceText="false"
                                         ToStringFunc="@(code => code)">
                            <ItemTemplate Context="code">@_airportLabels.GetValueOrDefault(code, code)</ItemTemplate>
                        </MudAutocomplete>
                    </MudItem>
                }

                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_model.PeriodBegin" Label="Period Begin" Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_model.PeriodEnd" Label="Period End" Required="true" />
                </MudItem>

                <MudItem xs="12" md="8">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">Operates On</MudText>
                    <MudChipSet T="int" SelectedValues="_selectedDays" SelectedValuesChanged="@(v => _selectedDays = new HashSet<int>(v))"
                                SelectionMode="SelectionMode.MultiSelection" CheckMark="true">
                        @foreach (var day in _dayOptions)
                        {
                            <MudChip T="int" Value="@day.Iso">@day.Label</MudChip>
                        }
                    </MudChipSet>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudCheckBox @bind-Value="_model.IsOverMidnight" Label="Over Midnight" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Comment" Label="Comment" Lines="2" MaxLength="500" />
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Additional Routing Legs</MudText>
                    @foreach (var leg in _model.Routings)
                    {
                        <div class="d-flex align-center mb-2" style="gap:8px">
                            <MudNumericField T="int" @bind-Value="leg.LegNumber" Label="Leg #" Min="1" Style="max-width:100px" />
                            <MudTextField @bind-Value="leg.AirportCode" Label="Airport" MaxLength="4" Style="max-width:140px" />
                            <MudTextField @bind-Value="leg.DirectionCode" Label="Direction" MaxLength="3" Style="max-width:120px" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => _model.Routings.Remove(leg))" />
                        </div>
                    }
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="AddRoutingLeg">Add Leg</MudButton>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudTooltip Text="Cancel">
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Cancel" />
        </MudTooltip>
        <MudTooltip Text="Save">
            <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary" OnClick="SubmitAsync" />
        </MudTooltip>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public SeasonalFlightScheduleArrivalFlightResponse? ExistingArrival { get; set; }

    [Parameter]
    public SeasonalFlightScheduleDepartureFlightResponse? ExistingDeparture { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<ScheduleSeasonResponse> Seasons { get; set; } = [];

    [Parameter]
    public string? DefaultScheduleSeasonCode { get; set; }

    private MudForm _form = null!;
    private readonly EditModel _model = new();
    private bool _directionEditable;
    private HashSet<int> _selectedDays = [1, 2, 3, 4, 5, 6, 7];

    private bool IsArrival => _model.Direction == SeasonalFlightScheduleFlightsPage.DirectionArrival;

    // ISO 8601 weekday numbers (Mon=1..Sun=7) — matches the position each digit occupies in the
    // stored OpsDays string (SeasonalFlightScheduleProcessorJob.OperatesOn reads it the same way).
    private static readonly (int Iso, string Label)[] _dayOptions =
        [(1, "Mon"), (2, "Tue"), (3, "Wed"), (4, "Thu"), (5, "Fri"), (6, "Sat"), (7, "Sun")];

    private static HashSet<int> ParseOpsDays(string? opsDays)
    {
        var days = new HashSet<int>();
        if (opsDays is { Length: 7 })
        {
            for (var i = 0; i < 7; i++)
            {
                var iso = i + 1;
                if (opsDays[i] == (char)('0' + iso))
                    days.Add(iso);
            }
        }
        return days;
    }

    private static string BuildOpsDays(IReadOnlyCollection<int> selectedIsoDays)
    {
        var chars = new char[7];
        for (var i = 0; i < 7; i++)
        {
            var iso = i + 1;
            chars[i] = selectedIsoDays.Contains(iso) ? (char)('0' + iso) : '.';
        }
        return new string(chars);
    }

    protected override void OnInitialized()
    {
        if (ExistingArrival is { } a)
        {
            _directionEditable = false;
            _model.Direction = SeasonalFlightScheduleFlightsPage.DirectionArrival;
            _model.ScheduleSeasonCode = a.ScheduleSeasonCode;
            _model.AirlineCode = a.AirlineCode;
            _model.FlightNumber = a.FlightNumber;
            _model.OriginAirportCode = a.OriginAirportCode;
            _model.PreviousAirportCode = a.Routings.FirstOrDefault(r => r.LegNumber == 1)?.AirportCode ?? "";
            _model.Time = a.Sta.TimeOfDay;
            _model.PeriodBegin = a.PeriodBegin.Date;
            _model.PeriodEnd = a.PeriodEnd.Date;
            _selectedDays = ParseOpsDays(a.OpsDays);
            _model.IsOverMidnight = a.IsOverMidnight;
            _model.AircraftTypeCode = a.AircraftTypeCode ?? "";
            _model.Comment = a.Comment ?? "";
            _model.Routings = a.Routings.Where(r => r.LegNumber > 1)
                .Select(r => new RoutingLegModel { LegNumber = r.LegNumber, AirportCode = r.AirportCode, DirectionCode = r.DirectionCode }).ToList();
        }
        else if (ExistingDeparture is { } d)
        {
            _directionEditable = false;
            _model.Direction = SeasonalFlightScheduleFlightsPage.DirectionDeparture;
            _model.ScheduleSeasonCode = d.ScheduleSeasonCode;
            _model.AirlineCode = d.AirlineCode;
            _model.FlightNumber = d.FlightNumber;
            _model.DestinationAirportCode = d.DestinationAirportCode;
            _model.NextAirportCode = d.Routings.FirstOrDefault(r => r.LegNumber == 1)?.AirportCode ?? "";
            _model.Time = d.Std.TimeOfDay;
            _model.PeriodBegin = d.PeriodBegin.Date;
            _model.PeriodEnd = d.PeriodEnd.Date;
            _selectedDays = ParseOpsDays(d.OpsDays);
            _model.IsOverMidnight = d.IsOverMidnight;
            _model.AircraftTypeCode = d.AircraftTypeCode ?? "";
            _model.Comment = d.Comment ?? "";
            _model.Routings = d.Routings.Where(r => r.LegNumber > 1)
                .Select(r => new RoutingLegModel { LegNumber = r.LegNumber, AirportCode = r.AirportCode, DirectionCode = r.DirectionCode }).ToList();
        }
        else
        {
            _directionEditable = true;
            if (DefaultScheduleSeasonCode is not null)
                _model.ScheduleSeasonCode = DefaultScheduleSeasonCode;
        }
    }

    // Leg 1 is reserved for the Previous/Next Airport field above — additional manually-entered
    // legs start at 2.
    private void AddRoutingLeg() => _model.Routings.Add(new RoutingLegModel { LegNumber = _model.Routings.Count + 2 });

    private readonly Dictionary<string, string> _airportLabels = new();
    private readonly Dictionary<string, string> _aircraftTypeLabels = new();

    private static string SeasonLabel(ScheduleSeasonResponse season) =>
        string.IsNullOrWhiteSpace(season.Description) ? season.Code : $"{season.Code} — {season.Description}";

    private Task<IEnumerable<string>> SearchAirportsAsync(string search, CancellationToken ct) =>
        MetadataCodeSearch.SearchWithLabelsAsync(MetadataData, MetadataCatalog.RouteOf("airports"), search, _airportLabels, ct);
    private Task<IEnumerable<string>> SearchAircraftTypesAsync(string search, CancellationToken ct) =>
        MetadataCodeSearch.SearchWithLabelsAsync(MetadataData, MetadataCatalog.RouteOf("aircrafttypes"), search, _aircraftTypeLabels, ct);

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid || _model.PeriodBegin is null || _model.PeriodEnd is null)
            return;

        var opsDays = BuildOpsDays(_selectedDays);
        var routings = BuildRoutings();

        SeasonalFlightScheduleFlightEditResult result;
        if (IsArrival)
        {
            var sta = ToUtcMidnight(_model.PeriodBegin.Value.Date + (_model.Time ?? TimeSpan.Zero));
            var request = new SeasonalFlightScheduleArrivalFlightRequest(
                _model.ScheduleSeasonCode, _model.AirlineCode, _model.FlightNumber,
                CallSign: null, ScheduleFlightStatusCode: null, CountryType: null,
                _model.AircraftTypeCode, opsDays, Frequency: 0, _model.IsOverMidnight,
                DirectionCode: null, IsTransit: false, Blank(_model.Comment),
                sta, ToUtcMidnight(_model.PeriodBegin.Value), ToUtcMidnight(_model.PeriodEnd.Value), _model.OriginAirportCode,
                routings);
            result = new SeasonalFlightScheduleFlightEditResult(SeasonalFlightScheduleFlightsPage.DirectionArrival, request, null);
        }
        else
        {
            var std = ToUtcMidnight(_model.PeriodBegin.Value.Date + (_model.Time ?? TimeSpan.Zero));
            var request = new SeasonalFlightScheduleDepartureFlightRequest(
                _model.ScheduleSeasonCode, _model.AirlineCode, _model.FlightNumber,
                CallSign: null, ScheduleFlightStatusCode: null, CountryType: null,
                _model.AircraftTypeCode, opsDays, Frequency: 0, _model.IsOverMidnight,
                DirectionCode: null, IsTransit: false, Blank(_model.Comment),
                std, Ptd: null, ToUtcMidnight(_model.PeriodBegin.Value), ToUtcMidnight(_model.PeriodEnd.Value), _model.DestinationAirportCode,
                routings);
            result = new SeasonalFlightScheduleFlightEditResult(SeasonalFlightScheduleFlightsPage.DirectionDeparture, null, request);
        }

        MudDialog.Close(DialogResult.Ok(result));
    }

    // The dedicated Previous/Next Airport field is just leg 1 of the routing table by convention —
    // there's no separate column for it anymore (it used to live on the main table; see
    // SeasonalFlightScheduleArrivalFlight/DepartureFlight). Manually-entered extra legs (>=2) are
    // renumbered to sit behind it, same convention the real flight's routing uses.
    private IReadOnlyList<SeasonalFlightScheduleRoutingRequest> BuildRoutings()
    {
        var result = new List<SeasonalFlightScheduleRoutingRequest>();
        var legNumber = 1;

        var immediateStop = IsArrival ? _model.PreviousAirportCode : _model.NextAirportCode;
        if (!string.IsNullOrWhiteSpace(immediateStop))
            result.Add(new SeasonalFlightScheduleRoutingRequest(immediateStop, legNumber++, "", null, null));

        foreach (var leg in _model.Routings.OrderBy(r => r.LegNumber))
            result.Add(new SeasonalFlightScheduleRoutingRequest(leg.AirportCode, legNumber++, leg.DirectionCode, null, null));

        return result;
    }

    private void Cancel() => MudDialog.Cancel();

    private static DateTimeOffset ToUtcMidnight(DateTime date) =>
        new(DateTime.SpecifyKind(date, DateTimeKind.Unspecified), TimeSpan.Zero);

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    private sealed class EditModel
    {
        public string Direction { get; set; } = SeasonalFlightScheduleFlightsPage.DirectionArrival;
        public string ScheduleSeasonCode { get; set; } = "";
        public string AirlineCode { get; set; } = "";
        public string FlightNumber { get; set; } = "";
        public string OriginAirportCode { get; set; } = "";
        public string PreviousAirportCode { get; set; } = "";
        public string DestinationAirportCode { get; set; } = "";
        public string NextAirportCode { get; set; } = "";
        public TimeSpan? Time { get; set; }
        public DateTime? PeriodBegin { get; set; } = DateTime.Today;
        public DateTime? PeriodEnd { get; set; } = DateTime.Today.AddMonths(6);
        public bool IsOverMidnight { get; set; }
        public string AircraftTypeCode { get; set; } = "";
        public string Comment { get; set; } = "";
        public List<RoutingLegModel> Routings { get; set; } = [];
    }

    private sealed class RoutingLegModel
    {
        public int LegNumber { get; set; } = 1;
        public string AirportCode { get; set; } = "";
        public string DirectionCode { get; set; } = "";
    }
}

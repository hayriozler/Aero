@page "/seasonal-flight-schedule/flights"
@attribute [Authorize]
@using AeroFlight.Contracts.SeasonalFlightSchedules
@using AeroFlight.Web.Services.SeasonalFlightSchedules
@inject ISeasonalFlightScheduleClient ScheduleClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Seasonal Flight Schedule — Flights</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">Seasonal Flight Schedule — Manual Flight Entry</MudText>
</div>

<MudSelect T="string" @bind-Value="_selectedScheduleSeasonCode" Label="Season" Clearable="true" Class="mb-4"
           @bind-Value:after="LoadAsync">
    @foreach (var season in _seasons)
    {
        <MudSelectItem T="string" Value="@season.Code">@season.Code</MudSelectItem>
    }
</MudSelect>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
}

<div class="d-flex justify-end mb-2">
    <MudTooltip Text="Add Schedule Flight">
        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="AddAsync" Disabled="@(_seasons.Count == 0)" />
    </MudTooltip>
</div>

<MudTable Items="_rows" Dense="true" Hover="true" Bordered="false" Elevation="1">
    <HeaderContent>
        <MudTh>Direction</MudTh>
        <MudTh>Airline</MudTh>
        <MudTh>Flight #</MudTh>
        <MudTh>Airport</MudTh>
        <MudTh>Time</MudTh>
        <MudTh>Period</MudTh>
        <MudTh>Ops Days</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Direction">@context.Direction</MudTd>
        <MudTd DataLabel="Airline">@context.AirlineCode</MudTd>
        <MudTd DataLabel="Flight #">@context.FlightNumber</MudTd>
        <MudTd DataLabel="Airport">@context.Airport</MudTd>
        <MudTd DataLabel="Time">@context.Time.ToString("HH:mm")</MudTd>
        <MudTd DataLabel="Period">@context.PeriodBegin.ToString("yyyy-MM-dd") — @context.PeriodEnd.ToString("yyyy-MM-dd")</MudTd>
        <MudTd DataLabel="Ops Days">@(context.OpsDays ?? "—")</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Color="Color.Secondary">No schedule flights defined yet.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    public const string DirectionArrival = "Arrival";
    public const string DirectionDeparture = "Departure";

    private List<ScheduleSeasonResponse> _seasons = [];
    private List<SeasonalFlightScheduleArrivalFlightResponse> _arrivals = [];
    private List<SeasonalFlightScheduleDepartureFlightResponse> _departures = [];
    private List<FlightRow> _rows = [];
    private string? _selectedScheduleSeasonCode;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _seasons = (await ScheduleClient.GetSeasonsAsync()).ToList();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to load seasons: {ex.Message}", Severity.Error);
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _arrivals = (await ScheduleClient.GetArrivalFlightsAsync(_selectedScheduleSeasonCode)).ToList();
            _departures = (await ScheduleClient.GetDepartureFlightsAsync(_selectedScheduleSeasonCode)).ToList();
            _rows = [
                .. _arrivals.Select(a => new FlightRow(DirectionArrival, a.AirlineCode, a.FlightNumber, a.OriginAirportCode, a.Sta, a.PeriodBegin, a.PeriodEnd, a.OpsDays, a, null)),
                .. _departures.Select(d => new FlightRow(DirectionDeparture, d.AirlineCode, d.FlightNumber, d.DestinationAirportCode, d.Std, d.PeriodBegin, d.PeriodEnd, d.OpsDays, null, d)),
            ];
            _rows = [.. _rows.OrderBy(r => r.AirlineCode).ThenBy(r => r.FlightNumber)];
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to load schedule flights: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var parameters = new DialogParameters<SeasonalFlightScheduleFlightEditDialog>
        {
            { x => x.Seasons, _seasons },
            { x => x.DefaultScheduleSeasonCode, _selectedScheduleSeasonCode },
        };
        var dialog = await DialogService.ShowAsync<SeasonalFlightScheduleFlightEditDialog>("Add Schedule Flight", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not SeasonalFlightScheduleFlightEditResult edit)
            return;

        try
        {
            if (edit.ArrivalRequest is { } arrivalRequest)
            {
                await ScheduleClient.CreateArrivalFlightAsync(arrivalRequest);
                Snackbar.Add("Arrival schedule flight created.", Severity.Success);
            }
            else if (edit.DepartureRequest is { } departureRequest)
            {
                await ScheduleClient.CreateDepartureFlightAsync(departureRequest);
                Snackbar.Add("Departure schedule flight created.", Severity.Success);
            }
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to create schedule flight: {ex.Message}", Severity.Error);
        }
    }

    private async Task EditAsync(FlightRow row)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var parameters = new DialogParameters<SeasonalFlightScheduleFlightEditDialog>
        {
            { x => x.ExistingArrival, row.Arrival },
            { x => x.ExistingDeparture, row.Departure },
            { x => x.Seasons, _seasons },
        };
        var title = row.Arrival is not null ? "Edit Arrival Schedule Flight" : "Edit Departure Schedule Flight";
        var dialog = await DialogService.ShowAsync<SeasonalFlightScheduleFlightEditDialog>(title, parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not SeasonalFlightScheduleFlightEditResult edit)
            return;

        try
        {
            if (row.Arrival is not null && edit.ArrivalRequest is { } arrivalRequest)
            {
                await ScheduleClient.UpdateArrivalFlightAsync(row.Arrival.Id, arrivalRequest);
                Snackbar.Add("Arrival schedule flight updated.", Severity.Success);
            }
            else if (row.Departure is not null && edit.DepartureRequest is { } departureRequest)
            {
                await ScheduleClient.UpdateDepartureFlightAsync(row.Departure.Id, departureRequest);
                Snackbar.Add("Departure schedule flight updated.", Severity.Success);
            }
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to update schedule flight: {ex.Message}", Severity.Error);
        }
    }

    private Task DeleteAsync(FlightRow row) => row.Arrival is not null ? DeleteArrivalAsync(row.Arrival) : DeleteDepartureAsync(row.Departure!);

    private async Task DeleteArrivalAsync(SeasonalFlightScheduleArrivalFlightResponse existing)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Arrival Schedule Flight", $"Remove flight '{existing.AirlineCode}{existing.FlightNumber}'?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
            return;

        try
        {
            await ScheduleClient.DeleteArrivalFlightAsync(existing.Id);
            Snackbar.Add("Arrival schedule flight removed.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to remove arrival schedule flight: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteDepartureAsync(SeasonalFlightScheduleDepartureFlightResponse existing)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Departure Schedule Flight", $"Remove flight '{existing.AirlineCode}{existing.FlightNumber}'?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
            return;

        try
        {
            await ScheduleClient.DeleteDepartureFlightAsync(existing.Id);
            Snackbar.Add("Departure schedule flight removed.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to remove departure schedule flight: {ex.Message}", Severity.Error);
        }
    }

    private sealed record FlightRow(
        string Direction,
        string AirlineCode,
        string FlightNumber,
        string Airport,
        DateTimeOffset Time,
        DateTimeOffset PeriodBegin,
        DateTimeOffset PeriodEnd,
        string? OpsDays,
        SeasonalFlightScheduleArrivalFlightResponse? Arrival,
        SeasonalFlightScheduleDepartureFlightResponse? Departure);
}

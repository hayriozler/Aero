@using System.Text.Json
@using AeroFlight.Contracts.Flights
@using AeroFlight.Web.Services.Flights
@using AeroFlight.Web.Services.Metadatas
@inject IFlightsClient Flights
@inject IMetadataClient Metadata
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<div class="d-flex justify-space-between align-center mb-2">
    <MudText Typo="Typo.subtitle2">Delays</MudText>
    <MudTooltip Text="Add Delay">
        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="AddAsync" Disabled="@ReadOnly" />
    </MudTooltip>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
}

<MudTable Items="_items" Dense="true" Hover="true" Bordered="false" Elevation="1" ReadOnly="@ReadOnly"
          EditTrigger="TableEditTrigger.EditButton" CanCancelEdit="true" IsEditRowSwitchingBlocked="true"
          RowEditPreview="BackupItem" RowEditCancel="RestoreItem" RowEditCommit="@(item => _ = CommitAsync((DelayRow)item))">
    <HeaderContent>
        <MudTh>Code</MudTh>
        <MudTh>Minutes</MudTh>
        <MudTh>Comment</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Code">@context.DelayCode</MudTd>
        <MudTd DataLabel="Minutes">@(context.DelayMinutes?.ToString("0.##") ?? "—")</MudTd>
        <MudTd DataLabel="Comment">@(context.Comment ?? "—")</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" Disabled="@ReadOnly" />
        </MudTd>
    </RowTemplate>
    <RowEditingTemplate>
        <MudTd DataLabel="Code">
            <MudAutocomplete T="string" @bind-Value="context.DelayCode" SearchFunc="SearchDelayReasonsAsync"
                              MinCharacters="0" CoerceText="false" Dense="true" Margin="Margin.Dense" />
        </MudTd>
        <MudTd DataLabel="Minutes">
            <MudNumericField T="decimal?" @bind-Value="context.DelayMinutes" Min="0" Margin="Margin.Dense" />
        </MudTd>
        <MudTd DataLabel="Comment">
            <MudTextField @bind-Value="context.Comment" Margin="Margin.Dense" />
        </MudTd>
        <MudTd></MudTd>
    </RowEditingTemplate>
    <NoRecordsContent>
        <MudText Color="Color.Secondary">No delays recorded yet.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    [Parameter, EditorRequired]
    public string RouteBase { get; set; } = "";

    [Parameter]
    public bool ReadOnly { get; set; }

    private List<DelayRow> _items = [];
    private DelayRow? _backup;
    private bool _loading;
    private string? _loadedRoute;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(RouteBase) || RouteBase == _loadedRoute)
            return;

        _loadedRoute = RouteBase;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = (await Flights.GetDelaysAsync(RouteBase)).Select(DelayRow.From).ToList();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to load delays: {ex.Message}", Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Could not reach the API while loading delays.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<FlightDelayEditDialog>("Add Delay", options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not DelayRequest request)
            return;

        try
        {
            await Flights.AddDelayAsync(RouteBase, request);
            Snackbar.Add("Delay added.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to add delay: {ex.Message}", Severity.Error);
        }
    }

    // MudTable hands back a snapshot before the row enters edit mode, so a Cancel click can
    // restore it — the row itself (DelayRow) is mutated live by the RowEditingTemplate bindings.
    private void BackupItem(object item) => _backup = ((DelayRow)item).Clone();

    private void RestoreItem(object item)
    {
        if (_backup is null)
            return;

        var row = (DelayRow)item;
        row.DelayCode = _backup.DelayCode;
        row.DelayMinutes = _backup.DelayMinutes;
        row.Comment = _backup.Comment;
        _backup = null;
    }

    private async Task CommitAsync(DelayRow row)
    {
        if (string.IsNullOrWhiteSpace(row.DelayCode))
        {
            Snackbar.Add("Delay code is required.", Severity.Warning);
            RestoreItem(row);
            StateHasChanged();
            return;
        }

        try
        {
            var request = new DelayRequest(row.DelayCode, row.DelayMinutes, Blank(row.Comment));
            var updated = await Flights.UpdateDelayAsync($"{RouteBase}/{row.Id}", request);
            row.DelayCode = updated.DelayCode;
            row.DelayMinutes = updated.DelayMinutes;
            row.Comment = updated.Comment;
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to update delay: {ex.Message}", Severity.Error);
            RestoreItem(row);
        }
        finally
        {
            _backup = null;
            StateHasChanged();
        }
    }

    private async Task DeleteAsync(DelayRow existing)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Delay", $"Remove delay '{existing.DelayCode}'?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
            return;

        try
        {
            await Flights.DeleteDelayAsync($"{RouteBase}/{existing.Id}");
            Snackbar.Add("Delay removed.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to remove delay: {ex.Message}", Severity.Error);
        }
    }

    private async Task<IEnumerable<string>> SearchDelayReasonsAsync(string search, CancellationToken ct)
    {
        try
        {
            var rows = await Metadata.GetAllAsync(MetadataCatalog.RouteOf("delayreasons"), ct);
            IEnumerable<IReadOnlyDictionary<string, JsonElement>> matches = rows;

            if (!string.IsNullOrWhiteSpace(search))
                matches = matches.Where(row => RowMatches(row, search));

            return matches
                .Select(row => row.TryGetValue("code", out var code) && code.ValueKind == JsonValueKind.String ? code.GetString() : null)
                .Where(code => !string.IsNullOrWhiteSpace(code))
                .Cast<string>()
                .Take(20);
        }
        catch (Exception)
        {
            return [];
        }
    }

    private static bool RowMatches(IReadOnlyDictionary<string, JsonElement> row, string search)
    {
        foreach (var value in row.Values)
        {
            if (value.ValueKind == JsonValueKind.String)
            {
                var s = value.GetString();
                if (!string.IsNullOrEmpty(s) && s.Contains(search, StringComparison.OrdinalIgnoreCase))
                    return true;
            }
        }
        return false;
    }

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    private sealed class DelayRow
    {
        public long Id { get; set; }
        public string DelayCode { get; set; } = "";
        public decimal? DelayMinutes { get; set; }
        public string? Comment { get; set; }

        public static DelayRow From(DelayResponse r) => new() { Id = r.Id, DelayCode = r.DelayCode, DelayMinutes = r.DelayMinutes, Comment = r.Comment };
        public DelayRow Clone() => new() { Id = Id, DelayCode = DelayCode, DelayMinutes = DelayMinutes, Comment = Comment };
    }
}

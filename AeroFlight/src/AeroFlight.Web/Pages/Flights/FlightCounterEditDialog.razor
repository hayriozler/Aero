@using AeroFlight.Web.Services
@using AeroFlight.Web.Services.Flights
@using AeroFlight.Web.Services.Metadatas
@inject IMetadataClient Metadata

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_model.Code" Label="Code" Clearable="true"
                               HelperText="Optional — leave blank to add a placeholder and assign a code later">
                        @foreach (var option in CodeOptions)
                        {
                            <MudSelectItem T="string" Value="@option.Code">@option.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Value="@_model.StatusCode" ValueChanged="OnStatusCodeChanged" Label="Status">
                        @foreach (var status in StatusOptions)
                        {
                            <MudSelectItem T="string" Value="@status.Code">@status.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_model.CheckinClassCode" Label="Check-in Class" Clearable="true">
                        @foreach (var option in CheckinClassOptions)
                        {
                            <MudSelectItem T="string" Value="@option.Code">@option.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_beginDate" Label="Begin Date" Clearable="true" DateFormat="@_dateFormat" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <TimeMaskTextField @bind-Time="_beginTime" Label="Begin Time" Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_endDate" Label="End Date" Clearable="true" DateFormat="@_dateFormat" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <TimeMaskTextField Time="_endTime" TimeChanged="OnEndTimeChanged" Label="End Time" Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_actualBeginDate" Label="Actual Begin Date" Clearable="true" DateFormat="@_dateFormat" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <TimeMaskTextField Time="_actualBeginTime" TimeChanged="OnActualBeginTimeChanged" Label="Actual Begin Time" Clearable="true"
                                       OnDoubleClick="StampActualBeginNowAndSaveAsync" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_actualEndDate" Label="Actual End Date" Clearable="true" DateFormat="@_dateFormat" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <TimeMaskTextField Time="_actualEndTime" TimeChanged="OnActualEndTimeChanged" Label="Actual End Time" Clearable="true"
                                       OnDoubleClick="StampActualEndNowAndSaveAsync" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string" @bind-Value="_model.PayerCompanyCode" Label="Payer" Clearable="true"
                                     SearchFunc="SearchPayerCompaniesAsync" MinCharacters="0" CoerceText="false" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudCheckBox T="bool" @bind-Value="_model.IsComplimentary" Label="Free of charge (complimentary)" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudTooltip Text="Cancel">
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Cancel" />
        </MudTooltip>
        <MudTooltip Text="Save">
            <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary" OnClick="SubmitAsync" />
        </MudTooltip>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    [Parameter]
    public FlightResourceResponse? Existing { get; set; }

    [Parameter]
    public IReadOnlyList<FlightResourceCodeOption> CodeOptions { get; set; } = [];

    // Sourced from CounterStatus (the Metadata table), not a shared hardcoded list.
    [Parameter]
    public IReadOnlyList<FlightResourceCodeOption> StatusOptions { get; set; } = [];

    // Sourced from the Check-in Class Metadata data — which class's board icon this counter
    // should show is decided by AeroFids from this code; AeroFlight only stores the code.
    [Parameter]
    public IReadOnlyList<FlightResourceCodeOption> CheckinClassOptions { get; set; } = [];

    [Parameter]
    public int DefaultDurationMinutes { get; set; } = AeroFlight.Contracts.Flights.ResourceDefaultsConstants.FallbackDurationMinutes;

    private MudForm _form = null!;
    private readonly EditModel _model = new();
    private DateTime? _beginDate;
    private TimeSpan? _beginTime;
    private DateTime? _endDate;
    private TimeSpan? _endTime;
    private DateTime? _actualBeginDate;
    private TimeSpan? _actualBeginTime;
    private DateTime? _actualEndDate;
    private TimeSpan? _actualEndTime;
    private TimeZoneInfo _tenantTimeZone = TimeZoneInfo.Utc;
    private string _dateFormat = TenantDateTimeFormat.DefaultDateFormat;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _tenantTimeZone = TenantTimeZone.Resolve(state.User);
            _dateFormat = TenantDateTimeFormat.ResolveDateFormat(state.User);
        }

        if (Existing is { } e)
        {
            _model.Code = e.Code ?? "";
            _model.StatusCode = e.StatusCode ?? "";
            _model.CheckinClassCode = e.CheckinClassCode ?? "";
            _model.PayerCompanyCode = e.PayerCompanyCode ?? "";
            _model.IsComplimentary = e.IsComplimentary;
            if (e.BeginPlan is { } bp)
            {
                var local = TenantTimeZone.ToLocal(bp, _tenantTimeZone);
                _beginDate = local.Date;
                _beginTime = local.TimeOfDay;
            }
            if (e.EndPlan is { } ep)
            {
                var local = TenantTimeZone.ToLocal(ep, _tenantTimeZone);
                _endDate = local.Date;
                _endTime = local.TimeOfDay;
            }
            if (e.BeginActual is { } ba)
            {
                var local = TenantTimeZone.ToLocal(ba, _tenantTimeZone);
                _actualBeginDate = local.Date;
                _actualBeginTime = local.TimeOfDay;
            }
            if (e.EndActual is { } ea)
            {
                var local = TenantTimeZone.ToLocal(ea, _tenantTimeZone);
                _actualEndDate = local.Date;
                _actualEndTime = local.TimeOfDay;
            }
        }
        else
        {
            _model.StatusCode = StatusOptions.FirstOrDefault(s => s.IsDefault)?.Code ?? StatusOptions.FirstOrDefault()?.Code ?? "";
            var nowLocal = TenantTimeZone.ToLocal(DateTimeOffset.UtcNow, _tenantTimeZone);
            var endLocal = nowLocal.AddMinutes(DefaultDurationMinutes);
            _beginDate = nowLocal.Date;
            _beginTime = nowLocal.TimeOfDay;
            _endDate = endLocal.Date;
            _endTime = endLocal.TimeOfDay;
        }
    }

    // Entering a time with no date yet is ambiguous, so default it to the Plan Begin date rather
    // than leaving it blank — End/Actual Begin/Actual End are almost always the same day.
    private void OnEndTimeChanged(TimeSpan? value)
    {
        _endTime = value;
        _endDate ??= _beginDate;
    }

    private void OnActualBeginTimeChanged(TimeSpan? value)
    {
        _actualBeginTime = value;
        _actualBeginDate ??= _beginDate;
    }

    private void OnActualEndTimeChanged(TimeSpan? value)
    {
        _actualEndTime = value;
        _actualEndDate ??= _beginDate;
    }

    // Double-click on the Actual Begin/End Time field is a shortcut for "this just happened, right
    // now" — stamps today's date/time instead of the operator typing both fields, and nudges the
    // status to match CounterStatus's own IsOpenValue/IsCloseValue status.
    private void StampActualBeginNow()
    {
        var nowLocal = TenantTimeZone.ToLocal(DateTimeOffset.UtcNow, _tenantTimeZone);
        _actualBeginDate = nowLocal.Date;
        _actualBeginTime = nowLocal.TimeOfDay;
        if (StatusOptions.FirstOrDefault(s => s.IsOpenValue) is { } open)
            _model.StatusCode = open.Code;
    }

    private void StampActualEndNow()
    {
        var nowLocal = TenantTimeZone.ToLocal(DateTimeOffset.UtcNow, _tenantTimeZone);
        _actualEndDate = nowLocal.Date;
        _actualEndTime = nowLocal.TimeOfDay;
        if (StatusOptions.FirstOrDefault(s => s.IsCloseValue) is { } closed)
            _model.StatusCode = closed.Code;
    }

    // The double-click gesture itself (unlike the status-driven stamp below) saves immediately —
    // matching the counter grid's own double-click, which persists the row right away rather than
    // waiting for a separate Save click.
    private async Task StampActualBeginNowAndSaveAsync()
    {
        StampActualBeginNow();
        await SubmitAsync();
    }

    private async Task StampActualEndNowAndSaveAsync()
    {
        StampActualEndNow();
        await SubmitAsync();
    }

    // Reverse of the above: manually picking an open/close-flagged status from the Status dropdown
    // stamps the matching Actual time to now, same as double-clicking that time field would.
    private void OnStatusCodeChanged(string value)
    {
        _model.StatusCode = value;
        var selected = StatusOptions.FirstOrDefault(s => string.Equals(s.Code, value, StringComparison.OrdinalIgnoreCase));
        if (selected?.IsOpenValue == true)
            StampActualBeginNow();
        else if (selected?.IsCloseValue == true)
            StampActualEndNow();
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
            return;

        var beginPlan = Combine(_beginDate, _beginTime);
        var endPlan = Combine(_endDate, _endTime);
        var beginActual = Combine(_actualBeginDate, _actualBeginTime);
        var endActual = Combine(_actualEndDate, _actualEndTime);

        var request = new FlightResourceRequest(
            Blank(_model.Code),
            beginPlan,
            endPlan,
            Blank(_model.StatusCode),
            beginActual,
            endActual,
            Blank(_model.PayerCompanyCode),
            _model.IsComplimentary,
            Blank(_model.CheckinClassCode));

        MudDialog.Close(DialogResult.Ok(request));
    }

    private DateTimeOffset? Combine(DateTime? date, TimeSpan? time) =>
        date is { } d ? TenantTimeZone.ToUtcOffset(d.Date + (time ?? TimeSpan.Zero), _tenantTimeZone) : null;

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    private async Task<IEnumerable<string>> SearchPayerCompaniesAsync(string search, CancellationToken ct) =>
        await MetadataCodeSearch.SearchAsync(Metadata, MetadataCatalog.RouteOf("companies"), search, ct);

    private void Cancel() => MudDialog.Cancel();

    private sealed class EditModel
    {
        public string Code { get; set; } = "";
        public string StatusCode { get; set; } = "";
        public string CheckinClassCode { get; set; } = "";
        public string PayerCompanyCode { get; set; } = "";
        public bool IsComplimentary { get; set; }
    }
}

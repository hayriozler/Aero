@using System.Text.Json
@using AeroFlight.Contracts.Flights
@using AeroFlight.Web.Services.Flights
@using AeroFlight.Web.Services.Metadatas
@inject IFlightsClient Flights
@inject IMetadataClient MetadataData
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<div class="d-flex justify-space-between align-center mb-2">
    <MudText Typo="Typo.subtitle2">Park Position allocations</MudText>
    <MudTooltip Text="Add Park Position">
        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="AddAsync" Disabled="@ReadOnly" />
    </MudTooltip>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
}

<MudTable Items="_items" Dense="true" Hover="true" Bordered="false" Elevation="1" Height="100%" FixedHeader="true">
    <HeaderContent>
        <MudTh>Code</MudTh>
        <MudTh>Plan Begin</MudTh>
        <MudTh>Actual Begin</MudTh>
        <MudTh>Plan End</MudTh>
        <MudTh>Actual End</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Code">
            <MudSelect T="string" Value="@(context.Code ?? "")" ValueChanged="@(v => UpdateCodeAsync(context, v))"
                       Clearable="true" Margin="Margin.Dense" Dense="true" Disabled="@ReadOnly" Style="min-width:110px">
                @foreach (var option in CodeOptions)
                {
                    <MudSelectItem T="string" Value="@option.Code">@option.Label</MudSelectItem>
                }
            </MudSelect>
        </MudTd>
        <MudTd DataLabel="Plan Begin">
            <div class="d-flex" style="gap:4px">
                <MudDatePicker Date="@ToLocalDate(context.BeginPlan)" DateChanged="@(d => UpdateBeginDateAsync(context, d))"
                               DateFormat="@_gridDateFormat" AutoClose="true" Margin="Margin.Dense" Disabled="@ReadOnly" Style="min-width:120px" />
                <TimeMaskTextField Time="@ToLocalTime(context.BeginPlan)" TimeChanged="@(t => UpdateBeginTimeAsync(context, t))"
                                   Margin="Margin.Dense" Disabled="@ReadOnly" Style="min-width:80px" />
            </div>
        </MudTd>
        <MudTd DataLabel="Actual Begin">
            <div class="d-flex" style="gap:4px">
                <MudDatePicker Date="@ToLocalDate(context.BeginActual)" DateChanged="@(d => UpdateActualBeginDateAsync(context, d))"
                               Clearable="true" DateFormat="@_gridDateFormat" AutoClose="true" Margin="Margin.Dense" Disabled="@ReadOnly" Style="min-width:120px" />
                <TimeMaskTextField Time="@ToLocalTime(context.BeginActual)" TimeChanged="@(t => UpdateActualBeginTimeAsync(context, t))"
                                   Margin="Margin.Dense" Disabled="@ReadOnly" Style="min-width:80px"
                                   OnDoubleClick="@(() => StampActualBeginNowAsync(context))" />
            </div>
        </MudTd>
        <MudTd DataLabel="Plan End">
            <div class="d-flex" style="gap:4px">
                <MudDatePicker Date="@ToLocalDate(context.EndPlan)" DateChanged="@(d => UpdateEndDateAsync(context, d))"
                               DateFormat="@_gridDateFormat" AutoClose="true" Margin="Margin.Dense" Disabled="@ReadOnly" Style="min-width:120px" />
                <TimeMaskTextField Time="@ToLocalTime(context.EndPlan)" TimeChanged="@(t => UpdateEndTimeAsync(context, t))"
                                   Margin="Margin.Dense" Disabled="@ReadOnly" Style="min-width:80px" />
            </div>
        </MudTd>
        <MudTd DataLabel="Actual End">
            <div class="d-flex" style="gap:4px">
                <MudDatePicker Date="@ToLocalDate(context.EndActual)" DateChanged="@(d => UpdateActualEndDateAsync(context, d))"
                               Clearable="true" DateFormat="@_gridDateFormat" AutoClose="true" Margin="Margin.Dense" Disabled="@ReadOnly" Style="min-width:120px" />
                <TimeMaskTextField Time="@ToLocalTime(context.EndActual)" TimeChanged="@(t => UpdateActualEndTimeAsync(context, t))"
                                   Margin="Margin.Dense" Disabled="@ReadOnly" Style="min-width:80px"
                                   OnDoubleClick="@(() => StampActualEndNowAsync(context))" />
            </div>
        </MudTd>
        <MudTd>
            <div class="d-flex justify-end" style="gap:4px">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(context))" Disabled="@ReadOnly" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" Disabled="@ReadOnly" />
            </div>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Color="Color.Secondary">No park position allocations yet.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    [Parameter, EditorRequired]
    public string RouteBase { get; set; } = "";

    [Parameter]
    public bool ReadOnly { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private List<OpsParkPositionResponse> _items = [];
    private List<FlightResourceCodeOption> _codeOptions = [];
    private int _defaultDurationMinutes = AeroFlight.Contracts.Flights.ResourceDefaultsConstants.FallbackDurationMinutes;
    private bool _loading;
    private string? _loadedRoute;
    private TimeZoneInfo _tenantTimeZone = TimeZoneInfo.Utc;
    private string _dateFormat = TenantDateTimeFormat.DefaultDateFormat;
    private string _timeFormat = TenantDateTimeFormat.DefaultTimeFormat;
    private string _gridDateFormat = "dd.MM";

    private IReadOnlyList<FlightResourceCodeOption> CodeOptions => _codeOptions;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _tenantTimeZone = TenantTimeZone.Resolve(state.User);
            _dateFormat = TenantDateTimeFormat.ResolveDateFormat(state.User);
            _timeFormat = TenantDateTimeFormat.ResolveTimeFormat(state.User);
        }

        if (string.IsNullOrWhiteSpace(RouteBase) || RouteBase == _loadedRoute)
            return;

        _loadedRoute = RouteBase;
        await LoadCodeOptionsAsync();
        await LoadDefaultDurationAsync();
        await LoadGridDateFormatAsync();
        await LoadAsync();
    }

    private async Task LoadGridDateFormatAsync()
    {
        try
        {
            _gridDateFormat = await Flights.GetResourceGridDateFormatAsync();
        }
        catch (Exception)
        {
            _gridDateFormat = "dd.MM";
        }
    }

    private async Task LoadCodeOptionsAsync()
    {
        try
        {
            var rows = await MetadataData.GetAllAsync(MetadataCatalog.RouteOf("parkpositions"));
            var options = new List<FlightResourceCodeOption>();
            foreach (var row in rows)
            {
                if (!row.TryGetValue("code", out var codeElement) || codeElement.ValueKind != JsonValueKind.String)
                    continue;

                var code = codeElement.GetString();
                if (string.IsNullOrWhiteSpace(code))
                    continue;

                var label = code;
                if (row.TryGetValue("description", out var descriptionElement) && descriptionElement.ValueKind == JsonValueKind.String)
                {
                    var description = descriptionElement.GetString();
                    if (!string.IsNullOrWhiteSpace(description))
                        label = $"{code} — {description}";
                }

                options.Add(new FlightResourceCodeOption(code, label));
            }

            _codeOptions = options;
        }
        catch (Exception)
        {
            Snackbar.Add("Could not load park position Metadata codes.", Severity.Warning);
        }
    }

    private async Task LoadDefaultDurationAsync()
    {
        try
        {
            _defaultDurationMinutes = await Flights.GetResourceDefaultDurationMinutesAsync("parkposition");
        }
        catch (Exception)
        {
            _defaultDurationMinutes = AeroFlight.Contracts.Flights.ResourceDefaultsConstants.FallbackDurationMinutes;
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = (await Flights.GetParkPositionsAsync(RouteBase)).ToList();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to load park position allocations: {ex.Message}", Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Could not reach the API while loading park position allocations.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddAsync()
    {
        var parameters = new DialogParameters<FlightParkPositionEditDialog>
        {
            { x => x.CodeOptions, _codeOptions },
            { x => x.DefaultDurationMinutes, _defaultDurationMinutes },
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<FlightParkPositionEditDialog>("Add Park Position", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not OpsParkPositionRequest request)
            return;

        try
        {
            await Flights.AddParkPositionAsync(RouteBase, request);
            Snackbar.Add("Park position added.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to add park position: {ex.Message}", Severity.Error);
        }
    }

    private async Task EditAsync(OpsParkPositionResponse existing)
    {
        var parameters = new DialogParameters<FlightParkPositionEditDialog>
        {
            { x => x.Existing, existing },
            { x => x.CodeOptions, _codeOptions },
            { x => x.DefaultDurationMinutes, _defaultDurationMinutes },
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<FlightParkPositionEditDialog>("Edit Park Position", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not OpsParkPositionRequest request)
            return;

        try
        {
            await Flights.UpdateParkPositionAsync($"{RouteBase}/{existing.Id}", request);
            Snackbar.Add("Park position updated.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to update park position: {ex.Message}", Severity.Error);
        }
    }

    private Task UpdateCodeAsync(OpsParkPositionResponse item, string? value) =>
        UpdateAsync(item, code: value, beginPlan: item.BeginPlan, endPlan: item.EndPlan, beginActual: item.BeginActual, endActual: item.EndActual);

    private Task UpdateBeginDateAsync(OpsParkPositionResponse item, DateTime? date) =>
        UpdateAsync(item, code: item.Code, beginPlan: CombineDate(item.BeginPlan, date), endPlan: item.EndPlan, beginActual: item.BeginActual, endActual: item.EndActual);

    private Task UpdateBeginTimeAsync(OpsParkPositionResponse item, TimeSpan? time) =>
        UpdateAsync(item, code: item.Code, beginPlan: CombineTime(item.BeginPlan, time), endPlan: item.EndPlan, beginActual: item.BeginActual, endActual: item.EndActual);

    private Task UpdateEndDateAsync(OpsParkPositionResponse item, DateTime? date) =>
        UpdateAsync(item, code: item.Code, beginPlan: item.BeginPlan, endPlan: CombineDate(item.EndPlan, date), beginActual: item.BeginActual, endActual: item.EndActual);

    private Task UpdateEndTimeAsync(OpsParkPositionResponse item, TimeSpan? time) =>
        UpdateAsync(item, code: item.Code, beginPlan: item.BeginPlan, endPlan: CombineTime(item.EndPlan, time), beginActual: item.BeginActual, endActual: item.EndActual);

    private Task UpdateActualBeginDateAsync(OpsParkPositionResponse item, DateTime? date) =>
        UpdateAsync(item, code: item.Code, beginPlan: item.BeginPlan, endPlan: item.EndPlan, beginActual: CombineDate(item.BeginActual, date), endActual: item.EndActual);

    private Task UpdateActualBeginTimeAsync(OpsParkPositionResponse item, TimeSpan? time) =>
        UpdateAsync(item, code: item.Code, beginPlan: item.BeginPlan, endPlan: item.EndPlan, beginActual: CombineTime(item.BeginActual, time), endActual: item.EndActual);

    private Task UpdateActualEndDateAsync(OpsParkPositionResponse item, DateTime? date) =>
        UpdateAsync(item, code: item.Code, beginPlan: item.BeginPlan, endPlan: item.EndPlan, beginActual: item.BeginActual, endActual: CombineDate(item.EndActual, date));

    private Task UpdateActualEndTimeAsync(OpsParkPositionResponse item, TimeSpan? time) =>
        UpdateAsync(item, code: item.Code, beginPlan: item.BeginPlan, endPlan: item.EndPlan, beginActual: item.BeginActual, endActual: CombineTime(item.EndActual, time));

    // Double-click on the Actual Begin/End time cell is a shortcut for "this just happened, right
    // now" — same gesture as the edit dialog, applied directly to the grid row and saved
    // immediately. Park positions have no status field, so there's nothing to nudge beyond the
    // timestamp itself.
    private Task StampActualBeginNowAsync(OpsParkPositionResponse item)
    {
        var nowLocal = TenantTimeZone.ToLocal(DateTimeOffset.UtcNow, _tenantTimeZone);
        var beginActual = TenantTimeZone.ToUtcOffset(nowLocal.Date + nowLocal.TimeOfDay, _tenantTimeZone);
        return UpdateAsync(item, code: item.Code, beginPlan: item.BeginPlan, endPlan: item.EndPlan, beginActual: beginActual, endActual: item.EndActual);
    }

    private Task StampActualEndNowAsync(OpsParkPositionResponse item)
    {
        var nowLocal = TenantTimeZone.ToLocal(DateTimeOffset.UtcNow, _tenantTimeZone);
        var endActual = TenantTimeZone.ToUtcOffset(nowLocal.Date + nowLocal.TimeOfDay, _tenantTimeZone);
        return UpdateAsync(item, code: item.Code, beginPlan: item.BeginPlan, endPlan: item.EndPlan, beginActual: item.BeginActual, endActual: endActual);
    }

    private async Task UpdateAsync(OpsParkPositionResponse item, string? code, DateTimeOffset? beginPlan, DateTimeOffset? endPlan, DateTimeOffset? beginActual, DateTimeOffset? endActual)
    {
        if (beginPlan is not { } bp || endPlan is not { } ep)
        {
            Snackbar.Add("Begin and end date/time are required.", Severity.Warning);
            return;
        }

        try
        {
            var request = new OpsParkPositionRequest(Blank(code), bp, ep, beginActual, endActual);
            await Flights.UpdateParkPositionAsync($"{RouteBase}/{item.Id}", request);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to update park position: {ex.Message}", Severity.Error);
        }
    }

    private DateTimeOffset? CombineDate(DateTimeOffset? existing, DateTime? newDate)
    {
        if (newDate is not { } date)
            return null;

        var time = existing is { } e ? TenantTimeZone.ToLocal(e, _tenantTimeZone).TimeOfDay : TimeSpan.Zero;
        return TenantTimeZone.ToUtcOffset(date.Date + time, _tenantTimeZone);
    }

    private DateTimeOffset? CombineTime(DateTimeOffset? existing, TimeSpan? newTime)
    {
        if (newTime is not { } time)
            return null;

        var date = existing is { } e ? TenantTimeZone.ToLocal(e, _tenantTimeZone).Date : DateTime.Today;
        return TenantTimeZone.ToUtcOffset(date + time, _tenantTimeZone);
    }

    private DateTime? ToLocalDate(DateTimeOffset? value) =>
        value is { } v ? TenantTimeZone.ToLocal(v, _tenantTimeZone).Date : null;

    private TimeSpan? ToLocalTime(DateTimeOffset? value) =>
        value is { } v ? TenantTimeZone.ToLocal(v, _tenantTimeZone).TimeOfDay : null;

    private async Task DeleteAsync(OpsParkPositionResponse existing)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Park Position", $"Remove park position '{existing.Code ?? "(no code)"}'?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
            return;

        try
        {
            await Flights.DeleteParkPositionAsync($"{RouteBase}/{existing.Id}");
            Snackbar.Add("Park position removed.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to remove park position: {ex.Message}", Severity.Error);
        }
    }

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    private string FormatDateTime(DateTimeOffset? value) =>
        value is { } v ? TenantTimeZone.ToLocal(v, _tenantTimeZone).ToString($"{_dateFormat} {_timeFormat}") : "—";
}

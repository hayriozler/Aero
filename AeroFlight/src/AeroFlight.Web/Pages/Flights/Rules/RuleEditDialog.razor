@using AeroFlight.Web.Services.Rules

<MudDialog>
    <DialogContent>
        @if (_loadingMetadata)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
        }
        else if (_metadata is null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true">Failed to load rule metadata from the API.</MudAlert>
        }
        else
        {
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-3">@_error</MudAlert>
            }

            <MudForm @ref="_form">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Rule Details</MudText>
                <MudGrid Spacing="3" Class="mb-4">
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" @bind-Value="_name" Label="Name" Required="true"
                                      RequiredError="Name is required" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" @bind-SelectedValues="_triggers" Label="Triggers" Required="true"
                                   RequiredError="At least one trigger is required" MultiSelection="true"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var t in _metadata.Triggers)
                            {
                                <MudSelectItem T="string" Value="@t.Key">@t.Label</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" @bind-Value="_description" Label="Description" Lines="2"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6" Class="d-flex flex-column">
                        <MudSwitch T="bool" @bind-Value="_stopOnMatch" Label="Stop on match" Color="Color.Primary" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            When this rule matches and its actions run, skip every rule after it for this event.
                            Off (default): keep evaluating the remaining rules too, in the order they were created.
                        </MudText>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="mb-3" />
                <div class="d-flex justify-space-between align-center mb-2">
                    <div>
                        <MudText Typo="Typo.subtitle1">Conditions</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Groups are combined with AND. Inside a group, choose whether it needs all or any of its conditions.</MudText>
                    </div>
                    <MudTooltip Text="Add Group">
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="AddGroup" />
                    </MudTooltip>
                </div>
                @if (_groups.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">No conditions — rule matches every triggering event.</MudText>
                }
                @for (var gi = 0; gi < _groups.Count; gi++)
                {
                    var group = _groups[gi];
                    var groupIdx = gi;
                    @if (groupIdx > 0)
                    {
                        <div class="d-flex justify-center my-1">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Default">AND</MudChip>
                        </div>
                    }
                    <MudPaper Outlined="true" Class="pa-3 mb-2">
                        <div class="d-flex justify-space-between align-center mb-2" style="gap:8px">
                            <MudSelect T="string" @bind-Value="group.Operator" Label="Match" Variant="Variant.Outlined"
                                       Margin="Margin.Dense" Style="max-width:220px">
                                <MudSelectItem T="string" Value="@("And")">All conditions (AND)</MudSelectItem>
                                <MudSelectItem T="string" Value="@("Or")">Any condition (OR)</MudSelectItem>
                            </MudSelect>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => _groups.RemoveAt(groupIdx))" />
                        </div>

                        @if (group.Conditions.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">No conditions in this group yet.</MudText>
                        }
                        @for (var i = 0; i < group.Conditions.Count; i++)
                        {
                            var row = group.Conditions[i];
                            var idx = i;
                            <MudGrid Spacing="2" Class="mb-1 align-center">
                                <MudItem xs="12" sm="4">
                                    <MudSelect T="string" Value="@row.Field" ValueChanged="@(v => OnConditionFieldChanged(row, v))"
                                               Label="Field" Variant="Variant.Outlined" Margin="Margin.Dense">
                                        @foreach (var f in FieldsForCondition())
                                        {
                                            <MudSelectItem T="string" Value="@f.Key">@f.Label</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="3">
                                    <MudSelect T="string" Value="@row.Operator" ValueChanged="@(v => row.Operator = v)"
                                               Label="Operator" Variant="Variant.Outlined" Margin="Margin.Dense">
                                        @foreach (var op in _metadata.Operators)
                                        {
                                            <MudSelectItem T="string" Value="@op.Key">@op.Label</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    @{
                                        var arity = OperatorArity(row.Operator);
                                        var enumValues = EnumValuesFor(row.Field);
                                    }
                                    @if (arity == "none")
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3">No value required</MudText>
                                    }
                                    else if (enumValues is not null)
                                    {
                                        <MudSelect T="string" @bind-Value="row.Value" Label="Value" Variant="Variant.Outlined" Margin="Margin.Dense">
                                            @foreach (var ev in enumValues)
                                            {
                                                <MudSelectItem T="string" Value="@ev.Value">@ev.Label</MudSelectItem>
                                            }
                                        </MudSelect>
                                    }
                                    else if (arity == "list")
                                    {
                                        <MudTextField T="string" @bind-Value="row.Value" Label="Values (comma-separated)"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    }
                                    else
                                    {
                                        <MudTextField T="string" @bind-Value="row.Value" Label="Value" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    }
                                </MudItem>
                                <MudItem xs="12" sm="1" Class="d-flex justify-end">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => group.Conditions.RemoveAt(idx))" />
                                </MudItem>
                            </MudGrid>
                        }
                        <MudTooltip Text="Add Condition">
                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="@(() => AddCondition(group))" />
                        </MudTooltip>
                    </MudPaper>
                }

                <MudDivider Class="my-3" />
                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.subtitle1">Actions</MudText>
                    <MudTooltip Text="Add Action">
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="AddAction" />
                    </MudTooltip>
                </div>
                @if (_actions.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">No actions defined yet.</MudText>
                }
                @for (var i = 0; i < _actions.Count; i++)
                {
                    var row = _actions[i];
                    var idx = i;
                    var matchValueField = FieldsForAction(row.ActionType).FirstOrDefault(f => f.Key == row.TargetField);
                    <MudGrid Spacing="2" Class="mb-1 align-center">
                        <MudItem xs="12" sm="2">
                            <MudSelect T="string" Value="@row.ActionType" ValueChanged="@(v => OnActionTypeChanged(row, v))"
                                       Label="Action Type" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var a in _metadata.ActionTypes)
                                {
                                    <MudSelectItem T="string" Value="@a.Key">@a.Label</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudSelect T="string" Value="@row.TargetField" ValueChanged="@(v => OnActionTargetFieldChanged(row, v))"
                                       Label="Target Field" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var f in FieldsForAction(row.ActionType))
                                {
                                    <MudSelectItem T="string" Value="@f.Key">@f.Label</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="@(matchValueField?.SupportsMatchValue == true ? 3 : 5)">
                            @{
                                var enumValues = EnumValuesFor(row.TargetField);
                            }
                            @if (enumValues is not null)
                            {
                                <MudSelect T="string" @bind-Value="row.Value" Label="Value" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var ev in enumValues)
                                    {
                                        <MudSelectItem T="string" Value="@ev.Value">@ev.Label</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else
                            {
                                <MudTextField T="string" @bind-Value="row.Value" Label="Value" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            }
                        </MudItem>
                        @if (matchValueField?.SupportsMatchValue == true)
                        {
                            <MudItem xs="12" sm="2">
                                <MudTextField T="string" @bind-Value="row.MatchValue" Label="@(matchValueField.MatchValueLabel ?? "Match Value")"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                        }
                        <MudItem xs="12" sm="2" Class="d-flex justify-end" style="gap:4px">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Disabled="@(idx == 0)"
                                           OnClick="@(() => MoveAction(idx, -1))" />
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Disabled="@(idx == _actions.Count - 1)"
                                           OnClick="@(() => MoveAction(idx, 1))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => _actions.RemoveAt(idx))" />
                        </MudItem>
                    </MudGrid>
                }
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudTooltip Text="Cancel">
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Cancel" Disabled="_saving" />
        </MudTooltip>
        @if (_saving)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" Class="mx-2" />
        }
        else
        {
            <MudTooltip Text="@(IsEdit ? "Save Changes" : "Create")">
                <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary" OnClick="SubmitAsync" Disabled="@(_metadata is null)" />
            </MudTooltip>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Inject]
    private IRulesClient Client { get; set; } = null!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = null!;

    [Parameter]
    public RuleResponse? Existing { get; set; }

    [Parameter]
    public RuleResponse? CopyFrom { get; set; }

    private bool IsEdit => Existing is not null;

    private MudForm _form = null!;
    private RuleMetadataResponse? _metadata;
    private bool _loadingMetadata = true;
    private bool _saving;
    private string? _error;

    private string _name = "";
    private string? _description;
    private IReadOnlyCollection<string> _triggers = new HashSet<string>();
    private bool _stopOnMatch;
    private readonly List<GroupRow> _groups = [];
    private readonly List<ActionRow> _actions = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _metadata = await Client.GetMetadataAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to load rule metadata: {ex.Message}", Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Could not reach the API while loading rule metadata.", Severity.Error);
        }
        finally
        {
            _loadingMetadata = false;
        }

        if (_metadata is null)
            return;

        _triggers = _metadata.Triggers.Count > 0 ? new HashSet<string> { _metadata.Triggers[0].Key } : new HashSet<string>();

        if ((Existing ?? CopyFrom) is { } rule)
        {
            _name = Existing is not null ? rule.Name : $"{rule.Name} (Copy)";
            _description = rule.Description;
            _triggers = new HashSet<string>(rule.Triggers);
            _stopOnMatch = rule.StopOnMatch;
            _groups.AddRange(rule.ConditionGroups.Select(g => new GroupRow
            {
                Operator = g.Operator,
                Conditions = [.. g.Conditions.Select(c => new ConditionRow { Field = c.Field, Operator = c.Operator, Value = c.Value })]
            }));
            _actions.AddRange(rule.Actions.OrderBy(a => a.Order).Select(a => new ActionRow { ActionType = a.ActionType, TargetField = a.TargetField, Value = a.Value, MatchValue = a.MatchValue }));
        }
    }

    private IEnumerable<MetadataField> FieldsForCondition() =>
        _metadata!.Fields.Where(f => f.UsableInCondition && _triggers.All(t => f.Triggers.Contains(t)));

    private IEnumerable<MetadataField> FieldsForAction(string actionType) =>
        _metadata!.Fields.Where(f => f.UsableInAction && _triggers.All(t => f.Triggers.Contains(t))
            && (f.ActionTypes is null || f.ActionTypes.Contains(actionType)));

    private string OperatorArity(string operatorKey) =>
        _metadata!.Operators.FirstOrDefault(o => o.Key == operatorKey)?.Arity ?? "single";

    private IReadOnlyList<MetadataEnumValue>? EnumValuesFor(string fieldKey) =>
        _metadata!.Fields.FirstOrDefault(f => f.Key == fieldKey)?.EnumValues;

    private void OnConditionFieldChanged(ConditionRow row, string value)
    {
        row.Field = value;
        row.Value = null;
    }

    private void OnActionTypeChanged(ActionRow row, string value)
    {
        row.ActionType = value;
        if (FieldsForAction(value).All(f => f.Key != row.TargetField))
            row.TargetField = FieldsForAction(value).FirstOrDefault()?.Key ?? "";

        if (_metadata!.Fields.FirstOrDefault(f => f.Key == row.TargetField)?.SupportsMatchValue != true)
            row.MatchValue = null;
    }

    private void OnActionTargetFieldChanged(ActionRow row, string value)
    {
        row.TargetField = value;
        if (_metadata!.Fields.FirstOrDefault(f => f.Key == value)?.SupportsMatchValue != true)
            row.MatchValue = null;
    }

    private void AddCondition(GroupRow group)
    {
        var defaultField = FieldsForCondition().FirstOrDefault()?.Key ?? "";
        var defaultOperator = _metadata!.Operators.FirstOrDefault()?.Key ?? "";
        group.Conditions.Add(new ConditionRow { Field = defaultField, Operator = defaultOperator });
    }

    private void AddGroup()
    {
        var group = new GroupRow();
        AddCondition(group);
        _groups.Add(group);
    }

    private void AddAction()
    {
        var defaultAction = _metadata!.ActionTypes.FirstOrDefault()?.Key ?? "";
        var defaultField = FieldsForAction(defaultAction).FirstOrDefault()?.Key ?? "";
        _actions.Add(new ActionRow { ActionType = defaultAction, TargetField = defaultField });
    }

    private void MoveAction(int index, int delta)
    {
        var newIndex = index + delta;
        if (newIndex < 0 || newIndex >= _actions.Count)
            return;

        (_actions[index], _actions[newIndex]) = (_actions[newIndex], _actions[index]);
    }

    private async Task SubmitAsync()
    {
        if (_metadata is null)
            return;

        await _form.ValidateAsync();
        if (!_form.IsValid)
            return;

        var request = new RuleRequest(
            _name,
            string.IsNullOrWhiteSpace(_description) ? null : _description,
            _triggers.ToList(),
            IsEdit ? Existing!.IsEnabled : true,
            _stopOnMatch,
            _groups.Where(g => g.Conditions.Count > 0)
                .Select(g => new RuleConditionGroupRequest(g.Operator, g.Conditions.Select(c => new RuleConditionRequest(c.Field, c.Operator, c.Value)).ToList()))
                .ToList(),
            _actions.Select((a, i) => new RuleActionRequest(a.ActionType, a.TargetField, a.Value, i, a.MatchValue)).ToList());

        _saving = true;
        _error = null;
        try
        {
            if (IsEdit)
                await Client.UpdateAsync(Existing!.Id, request);
            else
                await Client.CreateAsync(request);

            Snackbar.Add($"Rule '{_name}' saved.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (Exception)
        {
            _error = "Could not reach the API. Please try again.";
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private sealed class GroupRow
    {
        public string Operator { get; set; } = "And";
        public List<ConditionRow> Conditions { get; set; } = [];
    }

    private sealed class ConditionRow
    {
        public string Field { get; set; } = "";
        public string Operator { get; set; } = "";
        public string? Value { get; set; }
    }

    private sealed class ActionRow
    {
        public string ActionType { get; set; } = "";
        public string TargetField { get; set; } = "";
        public string? Value { get; set; }
        public string? MatchValue { get; set; }
    }
}

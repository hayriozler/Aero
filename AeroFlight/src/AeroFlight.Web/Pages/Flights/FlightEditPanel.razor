@using AeroFlight.Web.Services.Flights
@using AeroFlight.Web.Services.Metadatas
@inject IFlightsClient Flights
@inject IMetadataClient MetadataData
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

@if (Direction is null || Id is null)
{
    <MudPaper Class="pa-8 d-flex justify-center align-center" Elevation="1" Style="min-height:200px">
        <MudText Typo="Typo.body1" Color="Color.Secondary">Select a flight from the grid to view details</MudText>
    </MudPaper>
}
else if (_loading)
{
    <MudPaper Class="pa-6" Elevation="1">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </MudPaper>
}
else if (_notFound)
{
    <MudPaper Class="pa-6" Elevation="1">
        <MudAlert Severity="Severity.Warning">Flight not found. It may have been removed, or the link is stale.</MudAlert>
    </MudPaper>
}
else
{
    <MudPaper @key="@($"{Direction}:{Id}")" Class="pa-4" Elevation="1">
        <div class="d-flex justify-space-between align-center mb-2" style="gap:8px">
            <div class="d-flex align-center" style="gap:8px">
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@(() => OnClose.InvokeAsync())" />
                <div>
                    <MudText Typo="Typo.h6">@(_title ?? "Flight Detail")</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@(_isArrival ? "Arrival" : "Departure") flight #@Id</MudText>
                </div>
            </div>
            <div class="d-flex align-center" style="gap:8px">
                <MudTooltip Text="Previous Flight">
                    <MudIconButton Icon="@Icons.Material.Filled.NavigateBefore" OnClick="@(() => OnPrevious.InvokeAsync())" Disabled="@(!HasPrevious)" />
                </MudTooltip>
                <MudTooltip Text="Next Flight">
                    <MudIconButton Icon="@Icons.Material.Filled.NavigateNext" OnClick="@(() => OnNext.InvokeAsync())" Disabled="@(!HasNext)" />
                </MudTooltip>
                <MudTooltip Text="Refresh">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync" Disabled="@(_refreshing || _saving || _deleting)" />
                </MudTooltip>
                <MudTooltip Text="Delete">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                   OnClick="DeleteAsync" Disabled="@(_saving || _deleting)" />
                </MudTooltip>
                <MudTooltip Text="Save">
                    <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary"
                                   OnClick="SaveAsync" Disabled="@(_saving || _deleting)" />
                </MudTooltip>
            </div>
        </div>

        @if (_linkedFlightId is not null)
        {
            <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
                <div class="d-flex justify-space-between align-center" style="gap:8px">
                    <span>Linked flight: #@_linkedFlightId (@(_isArrival ? "Departure" : "Arrival"))</span>
                    <div class="d-flex align-center" style="gap:8px">
                        <MudTooltip Text="@($"View {(_isArrival ? "Departure" : "Arrival")}")">
                            <MudIconButton Icon="@(_isArrival ? Icons.Material.Filled.FlightTakeoff : Icons.Material.Filled.FlightLand)"
                                           Color="Color.Primary" OnClick="NavigateToLinkedAsync" />
                        </MudTooltip>
                        <MudTooltip Text="Unlink">
                            <MudIconButton Icon="@Icons.Material.Filled.LinkOff" Color="Color.Warning"
                                           Disabled="@IsLocked" OnClick="UnlinkAsync" />
                        </MudTooltip>
                    </div>
                </div>
            </MudAlert>
        }
        else
        {
            <div class="mb-3">
                <MudTooltip Text="@($"Link to {(_isArrival ? "Departure" : "Arrival")}")">
                    <MudIconButton Icon="@Icons.Material.Filled.Link" Color="Color.Primary" Disabled="@IsLocked" OnClick="LinkAsync" />
                </MudTooltip>
            </div>
        }

        @if (IsLocked)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true">
                Status "@_model.StatusCode" is locked — only Status can be changed. Pick a different status to edit the rest of the flight.
            </MudAlert>
        }

        <MudForm @ref="_form" Model="_model">
            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="pa-4">
                <MudTabPanel Text="General">
                    <MudText Typo="Typo.subtitle2" Class="mb-3">Core Identifiers</MudText>
                    <MudGrid Spacing="3" Class="mb-6">
                        <MudItem xs="12" md="3">
                            <MudTextField Value="@_airlineCode" Label="Airline" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudTextField @bind-Value="_model.FlightNumber" Label="Flight Number" Required="true"
                                          RequiredError="Flight number is required" MaxLength="FlightNumberFormat.MaxLength"
                                          Validation="@(new Func<string, string?>(FlightNumberFormat.Validate))"
                                          OnBlur="@(() => _model.FlightNumber = FlightNumberFormat.Normalize(_model.FlightNumber))"
                                          Disabled="@IsLocked" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudSelect T="string" @bind-Value="_model.StatusCode" Label="Status" Required="true"
                                       RequiredError="Status is required">
                                @foreach (var status in _flightStatuses)
                                {
                                    <MudSelectItem T="string" Value="@status.Code">@status.Label</MudSelectItem>
                                }
                            </MudSelect>
                            <div class="mt-1">
                                <MudChip T="string" Size="Size.Small" Color="@StatusColor(_model.StatusCode)">@_model.StatusCode</MudChip>
                            </div>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudTextField Value="@_flightDate.ToString(_dateFormat)" Label="Flight Date" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudTextField @bind-Value="_model.CallSign" Label="Call Sign" Disabled="@IsLocked" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudSelect T="string" @bind-Value="_model.FlightTypeCode" Label="Flight Type" Required="true"
                                       RequiredError="Flight type is required" Disabled="@IsLocked">
                                @foreach (var flightType in _flightTypes)
                                {
                                    <MudSelectItem T="string" Value="@flightType.Code">@flightType.Label</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudSelect T="string" @bind-Value="_model.TerminalCode" Label="Terminal" Clearable="true" Disabled="@IsLocked">
                                @foreach (var terminal in _terminals)
                                {
                                    <MudSelectItem T="string" Value="@terminal.Code">@terminal.Label</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>

                    <MudText Typo="Typo.subtitle2" Class="mb-3">Schedule</MudText>
                    <MudGrid Spacing="3" Class="mb-6">
                        <MudItem xs="12" md="3">
                            <MudDatePicker @bind-Date="_model.ScheduledDate" Label="@(_isArrival ? "Scheduled Arrival Date" : "Scheduled Departure Date")" Required="true" Disabled="@IsLocked" DateFormat="@_dateFormat" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <TimeMaskTextField @bind-Time="_model.ScheduledTime" Label="Scheduled Time (Local)" Required="true" Disabled="@IsLocked" />
                        </MudItem>
                        @if (_isArrival)
                        {
                            <MudItem xs="12" md="3"><MudDatePicker @bind-Date="_model.EtaDate" Label="ETA Date" Disabled="@IsLocked" DateFormat="@_dateFormat" /></MudItem>
                            <MudItem xs="12" md="3"><TimeMaskTextField Time="_model.EtaTime" TimeChanged="OnEtaTimeChanged" Label="ETA Time" Disabled="@IsLocked" /></MudItem>
                        }
                        else
                        {
                            <MudItem xs="12" md="3"><MudDatePicker @bind-Date="_model.EtdDate" Label="ETD Date" Disabled="@IsLocked" DateFormat="@_dateFormat" /></MudItem>
                            <MudItem xs="12" md="3"><TimeMaskTextField Time="_model.EtdTime" TimeChanged="OnEtdTimeChanged" Label="ETD Time" Disabled="@IsLocked" /></MudItem>
                        }
                    </MudGrid>

                    <MudText Typo="Typo.subtitle2" Class="mb-3">Routing</MudText>
                    <MudGrid Spacing="3">
                        <MudItem xs="12" md="4">
                            <MudAutocomplete T="string" @bind-Value="_model.AirportCode" Label="@(_isArrival ? "Origin (IATA)" : "Destination (IATA)")"
                                             Required="true" RequiredError="@(_isArrival ? "Origin is required" : "Destination is required")"
                                             SearchFunc="SearchAirportsAsync" MinCharacters="0" CoerceText="false" ResetValueOnEmptyText="false"
                                             ToStringFunc="@(code => code)" Disabled="@IsLocked">
                                <ItemTemplate Context="code">@_airportLabels.GetValueOrDefault(code, code)</ItemTemplate>
                            </MudAutocomplete>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField Value="@(_model.RoutingSummary ?? "—")" Label="Routing (first / last leg)" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField Value="@CountryTypeLabel(_model.CountryType)" Label="International/Domestic" ReadOnly="true" />
                        </MudItem>
                        @if (_isArrival)
                        {
                            <MudItem xs="12" md="4">
                                <MudAutocomplete T="string" @bind-Value="_model.DivertAirportCode" Label="Divert (IATA)" Clearable="true"
                                                 SearchFunc="SearchAirportsAsync" MinCharacters="0" CoerceText="false" ResetValueOnEmptyText="false"
                                                 ToStringFunc="@(code => code)" Disabled="@IsLocked">
                                    <ItemTemplate Context="code">@_airportLabels.GetValueOrDefault(code, code)</ItemTemplate>
                                </MudAutocomplete>
                            </MudItem>
                        }
                    </MudGrid>

                    <MudDivider Class="my-4" />

                    <FlightRoutingTable RouteBase="@RoutingResourceRoute" ReadOnly="@IsLocked" OnRoutingChanged="RefreshCountryTypeAsync" />
                </MudTabPanel>

                <MudTabPanel Text="Operational Times">
                    @if (_isArrival)
                    {
                        <MudGrid Spacing="3">
                            <MudItem xs="12" md="3"><MudDatePicker @bind-Date="_model.AtaDate" Label="ATA Date" Disabled="@IsLocked" DateFormat="@_dateFormat" /></MudItem>
                            <MudItem xs="12" md="3"><TimeMaskTextField @bind-Time="_model.AtaTime" Label="ATA Time" Disabled="@IsLocked" /></MudItem>
                            <MudItem xs="12" md="3"><MudDatePicker @bind-Date="_model.OnBlockDate" Label="On Block Date" Disabled="@IsLocked" DateFormat="@_dateFormat" /></MudItem>
                            <MudItem xs="12" md="3"><TimeMaskTextField @bind-Time="_model.OnBlockTime" Label="On Block Time" Disabled="@IsLocked" /></MudItem>
                        </MudGrid>
                    }
                    else
                    {
                        <MudGrid Spacing="3">
                            <MudItem xs="12" md="3"><MudDatePicker @bind-Date="_model.AtdDate" Label="ATD Date" Disabled="@IsLocked" DateFormat="@_dateFormat" /></MudItem>
                            <MudItem xs="12" md="3"><TimeMaskTextField @bind-Time="_model.AtdTime" Label="ATD Time" Disabled="@IsLocked" /></MudItem>
                            <MudItem xs="12" md="3"><MudDatePicker @bind-Date="_model.OffBlockDate" Label="Off Block Date" Disabled="@IsLocked" DateFormat="@_dateFormat" /></MudItem>
                            <MudItem xs="12" md="3"><TimeMaskTextField @bind-Time="_model.OffBlockTime" Label="Off Block Time" Disabled="@IsLocked" /></MudItem>
                        </MudGrid>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Aircraft & Handling">
                    <MudGrid Spacing="3">
                        <MudItem xs="12" md="4">
                            <MudAutocomplete T="string" @bind-Value="_model.AircraftCode" Label="Aircraft Registration" Clearable="true"
                                             SearchFunc="SearchAircraftAsync" MinCharacters="0" CoerceText="false" Disabled="@IsLocked" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudAutocomplete T="string" @bind-Value="_model.AircraftTypeCode" Label="Aircraft Type" Clearable="true"
                                             SearchFunc="SearchAircraftTypesAsync" MinCharacters="0" CoerceText="false" Disabled="@IsLocked" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudAutocomplete T="string" @bind-Value="_model.OperatingAirlineCode" Label="Operating Airline" Clearable="true"
                                             SearchFunc="SearchAirlinesAsync" MinCharacters="0" CoerceText="false" Disabled="@IsLocked" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Resources">
                    <div id="@ResourcesGridElementId" style="@ResourcesGridStyle">
                        <MudTabs Elevation="0" Rounded="true">
                            <MudTabPanel Text="Gates">
                                <FlightResourceTable RouteBase="@GateResourceRoute" Label="Gate" MetadataRoute="@MetadataCatalog.RouteOf("gates")" StatusMetadataRoute="@GateStatusMetadataRoute" ResourceKind="@(_isArrival ? "arrivalgate" : "departuregate")" ReadOnly="@IsLocked" />
                            </MudTabPanel>
                            <MudTabPanel Text="Belts">
                                <FlightResourceTable RouteBase="@BeltResourceRoute" Label="Belt" MetadataRoute="@BeltMetadataRoute" StatusMetadataRoute="@BeltStatusMetadataRoute" ResourceKind="@(_isArrival ? "arrivalbelt" : "departurebelt")" ReadOnly="@IsLocked" />
                            </MudTabPanel>
                            @if (!_isArrival)
                            {
                                <MudTabPanel Text="Counters">
                                    <FlightCounterTable RouteBase="@CounterResourceRoute" ReadOnly="@IsLocked" />
                                </MudTabPanel>
                            }
                            <MudTabPanel Text="Park Position">
                                <FlightParkPositionTable RouteBase="@ParkPositionResourceRoute" ReadOnly="@IsLocked" />
                            </MudTabPanel>
                            <MudTabPanel Text="Handling Services">
                                <FlightServiceTable RouteBase="@ServiceResourceRoute" ReadOnly="@IsLocked" />
                            </MudTabPanel>
                        </MudTabs>
                    </div>
                    <div id="@ResourcesGridHandleElementId" style="@ResourcesGridHandleStyle" title="Drag to resize">
                        <div style="width:48px; height:4px; border-radius:2px; background:var(--mud-palette-lines-default);"></div>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="Finance">
                    <FlightFinanceTable GateResourceRoute="@GateResourceRoute" BeltResourceRoute="@BeltResourceRoute"
                                        CounterResourceRoute="@(_isArrival ? null : CounterResourceRoute)"
                                        ParkPositionResourceRoute="@ParkPositionResourceRoute" ServiceResourceRoute="@ServiceResourceRoute" />
                </MudTabPanel>

                <MudTabPanel Text="Load & Pax">
                    <MudText Typo="Typo.subtitle2" Class="mb-3">Passengers & Crew</MudText>
                    <MudGrid Spacing="3" Class="mb-6">
                        <MudItem xs="12" md="3"><MudNumericField T="int?" @bind-Value="_model.PaxTransit" Label="Transit Pax" Min="0" Disabled="@IsLocked" /></MudItem>
                        <MudItem xs="12" md="3"><MudNumericField T="int?" @bind-Value="_model.PaxAssistanceRequired" Label="Assistance Required" Min="0" Disabled="@IsLocked" /></MudItem>
                        <MudItem xs="12" md="2"><MudNumericField T="int?" @bind-Value="_model.Pax1" Label="Adults" Min="0" Disabled="@IsLocked" /></MudItem>
                        <MudItem xs="12" md="2"><MudNumericField T="int?" @bind-Value="_model.Pax2" Label="Children" Min="0" Disabled="@IsLocked" /></MudItem>
                        <MudItem xs="12" md="2"><MudNumericField T="int?" @bind-Value="_model.Pax3" Label="Infants" Min="0" Disabled="@IsLocked" /></MudItem>
                        <MudItem xs="12" md="3"><MudNumericField T="int?" @bind-Value="_model.CrewNumber" Label="Crew Number" Min="0" Disabled="@IsLocked" /></MudItem>
                        <MudItem xs="12" md="3"><MudNumericField T="int?" @bind-Value="_model.CrewCockpit" Label="Cockpit Crew" Min="0" Disabled="@IsLocked" /></MudItem>
                    </MudGrid>

                    <MudText Typo="Typo.subtitle2" Class="mb-3">Weight & Cargo</MudText>
                    <MudGrid Spacing="3">
                        <MudItem xs="12" md="3"><MudNumericField T="decimal?" @bind-Value="_model.BaggageWeight" Label="Baggage Weight" Min="0" Disabled="@IsLocked" /></MudItem>
                        <MudItem xs="12" md="3"><MudNumericField T="decimal?" @bind-Value="_model.BaggageTotal" Label="Baggage Total" Min="0" Disabled="@IsLocked" /></MudItem>
                        <MudItem xs="12" md="3"><MudNumericField T="decimal?" @bind-Value="_model.CargoWeight" Label="Cargo Weight" Min="0" Disabled="@IsLocked" /></MudItem>
                        <MudItem xs="12" md="3"><MudNumericField T="decimal?" @bind-Value="_model.MailWeight" Label="Mail Weight" Min="0" Disabled="@IsLocked" /></MudItem>
                        <MudItem xs="12" md="3"><MudNumericField T="decimal?" @bind-Value="_model.TotalWeight" Label="Total Weight" Min="0" Disabled="@IsLocked" /></MudItem>
                        <MudItem xs="12" md="3"><MudNumericField T="decimal?" @bind-Value="_model.EquipmentWeight" Label="Equipment Weight" Min="0" Disabled="@IsLocked" /></MudItem>
                        <MudItem xs="12" md="3"><MudNumericField T="decimal?" @bind-Value="_model.CabinLuggage" Label="Cabin Luggage" Min="0" Disabled="@IsLocked" /></MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Remarks">
                    <MudGrid Spacing="3">
                        <MudItem xs="12" md="8">
                            <MudTextField @bind-Value="_model.Comment" Label="Public Comment" Lines="2" Disabled="@IsLocked" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="CodeShare">
                    <FlightCodeShareTable RouteBase="@CodeShareResourceRoute" ReadOnly="@IsLocked" />
                </MudTabPanel>

                <MudTabPanel Text="Delays">
                    <FlightDelayTable RouteBase="@DelayResourceRoute" ReadOnly="@IsLocked" />
                </MudTabPanel>

                <MudTabPanel Text="Movement Messages">
                    <MovementMessagesGrid RouteBase="@MovementMessageResourceRoute" />
                </MudTabPanel>

                <MudTabPanel Text="Audit">
                    <AuditHistoryGrid Loader="@(() => _isArrival ? Flights.GetArrivalAuditAsync(Id!.Value) : Flights.GetDepartureAuditAsync(Id!.Value))" />
                </MudTabPanel>
            </MudTabs>
        </MudForm>
    </MudPaper>
}


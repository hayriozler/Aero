@using AeroFlight.Web.Services.Flights
@inject IFlightsClient Flights

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Search for the @(IsArrival ? "departure" : "arrival") flight to link this one to.
            Only @(IsArrival ? "departures scheduled after this arrival's STA" : "arrivals scheduled before this departure's STD") are shown.
        </MudText>
        <MudAutocomplete T="FlightOption" @bind-Value="_selected"
                          SearchFunc="SearchAsync" ToStringFunc="@(o => o?.Label ?? "")"
                          Label="@($"Search {(IsArrival ? "Departure" : "Arrival")} Flights")"
                          MinCharacters="0" CoerceText="false" Clearable="true" />
    </DialogContent>
    <DialogActions>
        <MudTooltip Text="Cancel">
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Cancel" />
        </MudTooltip>
        <MudTooltip Text="Link">
            <MudIconButton Icon="@Icons.Material.Filled.Link" Color="Color.Primary" Disabled="@(_selected is null)" OnClick="Confirm" />
        </MudTooltip>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    // True when the flight being edited is an Arrival (so we search Departures to link to), false
    // when it's a Departure (so we search Arrivals).
    [Parameter]
    public bool IsArrival { get; set; }

    // The flight being edited's own scheduled time (STA if arrival, STD if departure) — candidates
    // are filtered to a real turnaround order, same rule FlightAutoLinker uses: a linked departure
    // must leave after this arrival lands, a linked arrival must land before this departure leaves.
    [Parameter]
    public DateTimeOffset MetadataTime { get; set; }

    private FlightOption? _selected;

    // Empty search (field just opened, nothing typed yet) shows a browsable slice of flights
    // instead of nothing, so opening the picker isn't a dead end.
    private async Task<IEnumerable<FlightOption>> SearchAsync(string search, CancellationToken ct)
    {
        try
        {
            var direction = IsArrival ? "Departure" : "Arrival";
            var result = await Flights.GetFlightsAsync(
                directions: [direction],
                search: string.IsNullOrWhiteSpace(search) ? null : search,
                page: 1, pageSize: 20, ct: ct);

            return result.Items
                .Select(ToOption)
                .Where(o => o is not null)
                .Cast<FlightOption>();
        }
        catch (Exception)
        {
            return [];
        }
    }

    private FlightOption? ToOption(MergedFlightRow row)
    {
        if (IsArrival)
            return row.DepartureId is { } departureId && row.Std is { } std && std > MetadataTime
                ? new FlightOption(departureId, $"{row.FlightCode} — {row.FlightDate:dd/MM/yyyy} STD {row.Std:HH:mm}")
                : null;

        return row.ArrivalId is { } arrivalId && row.Sta is { } sta && sta < MetadataTime
            ? new FlightOption(arrivalId, $"{row.FlightCode} — {row.FlightDate:dd/MM/yyyy} STA {row.Sta:HH:mm}")
            : null;
    }

    private void Confirm()
    {
        if (_selected is null)
            return;

        MudDialog.Close(DialogResult.Ok(_selected.Id));
    }

    private void Cancel() => MudDialog.Cancel();

    private sealed record FlightOption(long Id, string Label);
}

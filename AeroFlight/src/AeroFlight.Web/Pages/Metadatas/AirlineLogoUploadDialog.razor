@using Microsoft.AspNetCore.Components.Forms

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Give each logo a name before uploading.
        </MudText>
        @for (var i = 0; i < _rows.Count; i++)
        {
            var row = _rows[i];
            <MudGrid Spacing="2" Class="mb-2 align-center">
                <MudItem xs="12" sm="5">
                    <MudText Typo="Typo.body2" Class="text-truncate">@row.File.Name</MudText>
                </MudItem>
                <MudItem xs="12" sm="7">
                    <MudTextField @bind-Value="row.Name" Label="Name" Required="true" RequiredError="Name is required"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="50" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudTooltip Text="Cancel">
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Cancel" />
        </MudTooltip>
        <MudTooltip Text="Upload">
            <MudIconButton Icon="@Icons.Material.Filled.Upload" Color="Color.Primary" OnClick="Submit"
                           Disabled="@_rows.Any(r => string.IsNullOrWhiteSpace(r.Name))" />
        </MudTooltip>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public IReadOnlyList<IBrowserFile> Files { get; set; } = [];

    private List<Row> _rows = [];

    protected override void OnInitialized() =>
        _rows = [.. Files.Select(f => new Row(f, System.IO.Path.GetFileNameWithoutExtension(f.Name)))];

    private void Submit() =>
        MudDialog.Close(DialogResult.Ok(_rows.Select(r => new NamedFile(r.File, r.Name.Trim())).ToList()));

    private void Cancel() => MudDialog.Cancel();

    private sealed class Row(IBrowserFile file, string name)
    {
        public IBrowserFile File { get; } = file;
        public string Name { get; set; } = name;
    }

    public sealed record NamedFile(IBrowserFile File, string Name);
}

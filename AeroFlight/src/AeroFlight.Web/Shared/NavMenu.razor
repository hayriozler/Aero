@using AeroFlight.Web.Services.Metadatas

<MudNavMenu>
    <MudNavGroup Title="Resource Management" Icon="@Icons.Material.Filled.Construction" Expanded="true">
        <MudNavLink Href="flights/ops" Icon="@Icons.Material.Filled.Dashboard">AODB Ops Desk</MudNavLink>
        <MudNavLink Href="rules" Icon="@Icons.Material.Filled.Rule">Rules</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Metadata Data" Icon="@Icons.Material.Filled.Storage" Expanded="false">
        @foreach (var group in MetadataCatalog.Groups)
        {
            <MudNavGroup Title="@group.Key" Icon="@MetadataCatalog.GroupIcon(group.Key)" Expanded="false">
                @foreach (var entity in group)
                {
                    <MudNavLink Href="@($"Metadata/{entity.Key}")" Icon="@entity.Icon">@entity.Title</MudNavLink>
                }
            </MudNavGroup>
        }
    </MudNavGroup>

    <MudNavGroup Title="Seasonal Schedule" Icon="@Icons.Material.Filled.EventRepeat" Expanded="false">
        <MudNavLink Href="seasonal-flight-schedule/seasons" Icon="@Icons.Material.Filled.CalendarMonth">Seasons</MudNavLink>
        <MudNavLink Href="seasonal-flight-schedule/flights" Icon="@Icons.Material.Filled.FlightTakeoff">Flights</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Administration" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
        <MudNavLink Href="admin/roles" Icon="@Icons.Material.Filled.Badge">Roles</MudNavLink>
        <MudNavLink Href="admin/users" Icon="@Icons.Material.Filled.ManageAccounts">Users</MudNavLink>
    </MudNavGroup>

</MudNavMenu>
